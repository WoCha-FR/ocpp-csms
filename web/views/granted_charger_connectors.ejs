<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row align-items-center">
        <div class="col-md-auto fs-2"><%=texts.STATION%>&nbsp;<%=station.cb_name%></div>
        <div class="col" id="cbonline">
        <% if(station.online==1) { %>
          <span class="badge text-bg-success fs-6"><%=texts.ONLINE%></span>
        <% } else if(station.online==0) { %>
          <span class="badge text-bg-danger fs-6"><%=texts.OFFLINE%></span>
        <% } else { %>
          <span class="badge text-bg-warning fs-6"><%=texts.PENDING%></span>
        <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('./partials/ocpperrors.ejs') %>
  <% if (typeof infosui.ocppResult !=='undefined' ) { %>
    <% if (infosui.ocppResult.status=='Rejected' ) { %>
      <div id="ocppResponse" class="alert alert-danger" role="alert"><%=texts.REJECTEDM%></div>
    <% } else if(infosui.ocppResult.status=='NotSupported' ) { %>
      <div id="ocppResponse" class="alert alert-warning" role="alert"><%=texts.NOT_SUPPORTED%></div>
    <% } else if(infosui.ocppResult.status=='RebootRequired' ) { %>
      <div id="ocppResponse" class="alert alert-warning" role="alert"><%=texts.REBOOT_REQUIRED%></div>
    <% } else if(infosui.ocppResult.status=='Accepted' ) { %>
      <div id="ocppResponse" class="alert alert-success" role="alert"><%=texts.ACCEPTEDM%></div>
    <% } else if(infosui.ocppResult.status=='Updated' ) { %>
      <div id="ocppResponse" class="alert alert-success" role="alert"><%=texts.UPDATED%></div>
    <% } else { %>
      <div id="ocppResponse" class="alert alert-warning" role="alert"><%=infosui.ocppResult.status%></div>
    <% } %>
  <% } %>
  <div class="card">
    <!-- CARD HEADER-->
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs">
        <li>
          <a class="nav-link" href="/charger/<%=station.cb_id%>"><%=texts.STATION%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/charger/<%=station.cb_id%>/connectors"><%=texts.CONNECTORS%></a>
        </li>
        <% if (userInfo.isAdmin == 1) { %>
        <li class="nav-item">
          <a class="nav-link" href="/charger/<%=station.cb_id%>/logs"><%=texts.LOGS%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/charger/<%=station.cb_id%>/ocppconfig"><%=texts.CONFIG_OCPP%></a>
        </li>
        <% } %>
      </ul>
    </div><!-- CARD HEADER-->
    <!-- CARD BODY -->
    <div class="card-body">
      <!-- CONNECTORS ARRAY -->
      <% conns.forEach(function(conn) { if (conn.pk) { %>
      <div class="card h-100 mb-2">
        <!-- HEADER : STATUS -->
        <div class="card-header">
          <small class="d-inline-flex mb-0 px-2 py-1 fw-bold text-white bg-secondary border border-secondary rounded-2">
            <i class="bi bi-ev-station"></i>&nbsp;<%=texts.CONNECTOR%>&nbsp;<%=conn.connector_id%>
          </small>
          <small class="d-inline-flex mb-0 px-2 py-1 fw-bold text-white bg-secondary border border-secondary rounded-2">
            <i class="bi bi-lightning-charge-fill"></i>&nbsp;<span id="conKwh<%=conn.pk%>"><%=(conn.energy /1000)%></span>&nbsp;<%=texts.ENERGYUNIT%>
          </small>
          <div class="float-end">
            <h5 id="connstatus<%=conn.pk%>">
              <% if (conn.status=='Unavailable' || conn.status=='Faulted') { %>
              <span class="badge text-bg-danger"><%=conn.status%></span>
              <% } else if (conn.status=='Available') { %>
              <span class="badge text-bg-success"><%=conn.status%></span>
              <% } else if (conn.status=='Charging') { %>
              <span class="badge text-bg-info"><%=conn.status%></span>
              <% } else { %>
              <span class="badge text-bg-warning"><%=conn.status%></span>
              <% } %>
            </h5>
          </div>
        </div>
        <!-- BODY -->
        <div class="card-body">
          <div class="row">
            <div class="col-sm-2">
              <form action="/charger/<%=station.cb_id%>/remotestart" method="post" id="btnStart<%=conn.pk%>" class="<% if(conn.status!='Available' && conn.status!='Preparing' ) { %>d-none<% } %>">
                <input type="hidden" id="connectorId<%=conn.pk%>" name="connectorId" value="<%=conn.connector_id%>">
                <button type="submit" id="remoteStart<%=conn.pk%>" class="btn btn-success btn-sm mb-2 w-100 ocppReq"<% if(station.online!==1) { %> disabled<% } %>>
                  <%=texts.START_CHARGING%>
                </button>
              </form>
              <form action="/charger/<%=station.cb_id%>/remotestop" method="post" id="btnStop<%=conn.pk%>" class="<% if(conn.status!='Charging' && conn.status!='SuspendedEVSE' && conn.status!='SuspendedEV' ) { %>d-none<% } %>">
                <input type="hidden" id="transId<%=conn.pk%>" name="transId" value="<%if (!conn.tsStop) { %><%=conn.t_pk%><% } %>">
                <button type="submit" id="remoteStop<%=conn.pk%>" class="btn btn-danger btn-sm mb-2 w-100 ocppReq"<% if(station.online!==1) { %> disabled<% } %>>
                  <%=texts.STOP_CHARGING%>
                </button>
              </form>
              <form action="/charger/<%=station.cb_id%>/unlockcon" method="post">
                <input type="hidden" id="connectorId<%=conn.pk%>" name="connectorId" value="<%=conn.connector_id%>">
                <button type="submit" id="UnlockConn<%=conn.pk%>" class="btn btn-secondary btn-sm w-100 ocppReq"<% if(station.online!==1) { %> disabled<% } %>>
                  <%=texts.UNLOCK_CONN%>
                </button>
              </form>
            </div>
            <div class="col-sm-4">
              <div class="card h-100">
                <div class="card-header fs-6 fw-bold"><%=texts.CONNECTOR_INFOS%></div>
                <div class="card-body">
                  <div class="row">
                    <div class="col"><%=texts.NOM%>:&nbsp;<span class="fw-bold"><%- conn.cname ? conn.cname : texts.CONNECTOR + ' ' + conn.connector_id %></span></div>
                    <div class="col"><%=texts.MAX_POWER%>:&nbsp;<span class="fw-bold"><%=conn.maxPower%>&nbsp;<%=texts.POWERUNIT%></span></div>
                  </div>
                  <div class="row">
                    <div class="col"><%=texts.FORMAT%>:&nbsp;
                      <span class="fw-bold">
                        <% if (conn.format==1) { %><%=texts.CONNECTOR_SOCKET%><% } %>
                        <% if (conn.format==2) { %><%=texts.CONNECTOR_CABLE%><% } %>
                      </span>
                    </div>
                    <div class="col"><%=texts.TYPE%>:&nbsp;
                      <span class="fw-bold">
                        <% if (conn.type==1) { %>Type 2<% } %>
                        <% if (conn.type==2) { %>Combo CCS<% } %>
                        <% if (conn.type==3) { %>Type 1<% } %>
                        <% if (conn.type==4) { %>CHAdeMO<% } %>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="col">
              <!-- Transactions -->
              <div class="card h-100<% if (!conn.t_pk) {%> invisible<%}%>" id="trans<%=conn.pk%>">
                <span id="transActiv<%=conn.pk%>" class="d-none"><%if (conn.tsStop) { %>non<% } %><%if (conn.tsStart) { %>oui<% } %></span>
                <span id="transTimer<%=conn.pk%>" class="d-none"></span>
                <div class="card-header fs-6 fw-bold">
                  <span id="transState<%=conn.pk%>"><%if (conn.tsStop) { %>
                    <%=texts.TRANSAC_DERNIERE%><% } else { %>
                    <%=texts.TRANSAC_ENCOURS%><% } %>
                  </span>
                  <div class="float-end">
                    <a id="transHisto<%=conn.pk%>" href="/reports/charge/<%=conn.t_pk%>"><i class="bi bi-file-bar-graph" style="cursor: pointer;"></i></a>
                  </div>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col">
                      <span class="fw-bold"><%=texts.USER%>:&nbsp;</span><span id="transUser<%=conn.pk%>">
                        <% if (conn.uname) { %><%= conn.uname %><% } else if (conn.rf_name) { %><%= conn.rf_name %><% } else { %><%= texts.FREE_CHARGE %><% } %>
                      </span>
                    </div>
                    <div class="col"><% let date1=new Date(conn.tsStart * 1000) %>
                      <span class="fw-bold"><%=texts.START%>:&nbsp;</span><span id="transDeb<%=conn.pk%>"><%= date1.toLocaleDateString(texts.LOCALE) %>&nbsp;<%= date1.toLocaleTimeString(texts.LOCALE) %></span>
                    </div>
                    <div class="col">
                      <span class="fw-bold"><%=texts.END%>:&nbsp;</span><% if (conn.tsStop) { let date2=new Date(conn.tsStop * 1000); %>
                      <span id="transFin<%=conn.pk%>"><%= date2.toLocaleDateString(texts.LOCALE) %>&nbsp;<%= date2.toLocaleTimeString(texts.LOCALE) %></span><% } else { %>
                      <span id="transFin<%=conn.pk%>"></span><% } %>
                    </div>
                  </div>
                  <div class="row">
                    <div class="col">
                      <span class="fw-bold"><%=texts.DURATION%>:&nbsp;</span>
                      <span id="transTime<%=conn.pk%>"></span>
                    </div>
                    <div class="col"><% let energy=(conn.tsEnergy / 1000); %>
                      <span class="fw-bold"><%=texts.ENERGY_CONSUMED%>:&nbsp;</span><span id="transKwh<%=conn.pk%>"><%= energy %></span>&nbsp;<%=texts.ENERGYUNIT%>
                    </div>
                    <div class="col" id="transPwrStop<%=conn.pk%>"><% if (conn.tsStop) { %>
                      <span class="fw-bold"><%=texts.REASON%>:&nbsp;</span><%= conn.tsReason %><% } else { let power=(conn.tsPower / 1000); %>
                      <span class="fw-bold"><%=texts.POWER%>:&nbsp;</span><%= power %>&nbsp;<%=texts.POWERUNIT%><% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div><!-- BODY -->
      </div>
      <% } else { %><%=texts.NO_INFOS%><% } }); %>
    </div><!-- CARD BODY -->
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#ocppResponse').delay(3000).fadeOut('slow')
    $('#inputErrors').delay(5000).fadeOut('slow')
  });
  // Set duration
  const connectors = JSON.parse('<%-JSON.stringify(conns)%>');
  for (const elem of connectors) {
    const transDeb = new Date(elem.tsStart * 1000)
    // Session Terminée
    if (elem.tsStart && elem.tsStop) {
      const transFin = new Date(elem.tsStop * 1000)
      const duration = ((transFin.getTime() - transDeb.getTime()) / 1000)
      $('#transTime' + elem.pk).html(secToString(duration))
    }
    // Session en Cours
    if(elem.tsStart && !elem.tsStop) {
      const thisTime = new Date()
      let duration = ((thisTime.getTime() - transDeb.getTime()) / 1000)
      $('#transTime' + elem.pk).html(secToString(duration))
      const timerID = setInterval(function () {
        $('#transTime' + elem.pk).html(secToString(++duration))
      }, 1000)
      $('#transTimer' + elem.pk).html(timerID)
    }
  }
  // Refresh Connector Data
  // TODO: Rafraichir la page si session de charge démarre/termine
  const interval1 = setInterval(reloadConnsStatus, 2500);
  function reloadConnsStatus() {
    $.ajax({
      url: '/ajax/connectors_status',
      type: 'POST',
      data: { ocppName: '<%=station.cb_id%>' },
      dataType: 'json',
      success: function (result) {
        for (const elem of result.data) {
          // Nouveau Connecteur ?
          if (elem.pk && document.body.contains(document.querySelector('#connstatus' + elem.pk)) === false) {
            location.reload();
          }
          // Online / Offline
          if (elem.online === 1) {
            $('.ocppReq').prop('disabled', false);
            $('#cbonline').html('<span class="badge text-bg-success fs-6"><%=texts.ONLINE%></span>')
          } else {
            $('.ocppReq').prop('disabled', true);
            if (elem.online === 0) {
              $('#cbonline').html('<span class="badge text-bg-danger fs-6"><%=texts.OFFLINE%></span>')
            } else {
              $('#cbonline').html('<span class="badge text-bg-warning fs-6"><%=texts.PENDING%></span>')
            }
          }
          const status_bg = '#connstatus' + elem.pk
          // Status Badge
          if (elem.status == 'Unavailable' || elem.status == 'Faulted') {
            $(status_bg).html('<span class="badge text-bg-danger">' + elem.status + '</span>');
          } else if (elem.status == 'Available') {
            $(status_bg).html('<span class="badge text-bg-success">' + elem.status + '</span>');
          } else if (elem.status == 'Charging') {
            $(status_bg).html('<span class="badge text-bg-info">' + elem.status + '</span>');
          } else {
            $(status_bg).html('<span class="badge text-bg-warning">' + elem.status + '</span>');
          }
          // Action button
          if (elem.status == 'Available' || elem.status == 'Preparing') {
            $('#btnStart' + elem.pk).removeClass('d-none');
          } else {
            $('#btnStart' + elem.pk).addClass('d-none');
          }
          if (elem.status == 'Charging' || elem.status == 'SuspendedEVSE' || elem.status == 'SuspendedEV') {
            $('#btnStop' + elem.pk).removeClass('d-none');
          } else {
            $('#btnStop' + elem.pk).addClass('d-none');
          }
          // Meter
          $('#conKwh' + elem.pk).html((elem.energy / 1000));
        }
      },
      error: function (jqXHR, textStatus, err) {
        alert(jqXHR.responseText)
        clearInterval(interval1)
      }
    });
  }
  // Ajax Update Transaction
  const interval2 = setInterval(reloadTransactionsStatus, 30000)
  function reloadTransactionsStatus() {
    $.ajax({
      url: '/ajax/connectors_last_trans',
      type: 'POST',
      data: { ocppName: '<%=station.cb_id%>' },
      dataType: 'json',
      success: function (result) {
        for (const elem of result.data) {
          // Transaction terminée
          if (elem.tsStop) {
            // Etait en cours ? => on modifie
            if ($('#transActiv' + elem.pk).html() == 'oui') {
              $('#transHisto' + elem.pk).prop('href', '/reports/charge/' + elem.t_pk)
              // Fin du timer + modif state
              clearInterval($('#transTimer' + elem.pk).html())
              $('#transActiv' + elem.pk).html('non')
              $('#transTimer' + elem.pk).html('')
              // Modification Titre
              $('#transState' + elem.pk).html('<%=texts.TRANSAC_DERNIERE%>')
              // Fin session + durée
              const transDeb = new Date(elem.tsStart * 1000)
              const transFin = new Date(elem.tsStop * 1000)
              $('#transFin' + elem.pk).html(transFin.toLocaleDateString() + '&nbsp;' + transFin.toLocaleTimeString())
              const duration = ((transFin.getTime() - transDeb.getTime()) / 1000)
              $('#transTime' + elem.pk).html(secToString(duration))
              // Energie + Reason
              $('#transKwh' + elem.pk).html(elem.tsEnergy / 1000)
              $('#transPwrStop' + elem.pk).html('<span class="fw-bold"><%=texts.REASON%>:&nbsp;</span>' + elem.tsReason)
              $('#transId' + elem.pk).val('')
            }
           // Transaction en cours
           } else {
            // Nouvelle transaction ?
            $('#trans' + elem.pk).removeClass('invisible')
            if ($('#transActiv' + elem.pk).html() != 'oui') {
              $('#transHisto' + elem.pk).prop('href', '/reports/charge/' + elem.t_pk)
              $('#transId' + elem.pk).val(elem.t_pk)
              // Passage en actif & MaJ des données
              $('#transState' + elem.pk).html('<%=texts.TRANSAC_ENCOURS%>')
              $('#transActiv' + elem.pk).html('oui')
              // Utilisateur
              if (elem.uname) {
                $('#transUser' + elem.pk).html(elem.uname)
              } else if (elem.rf_name) {
                $('#transUser' + elem.pk).html(elem.rfname)
              } else {
                $('#transUser' + elem.pk).html('<%= texts.FREE_CHARGE %>')
              }
              // Début & Timer
              const transDeb = new Date(elem.tsStart * 1000)
              $('#transDeb' + elem.pk).html(transDeb.toLocaleDateString() + '&nbsp;' + transDeb.toLocaleTimeString())
              $('#transFin' + elem.pk).html('')
              // Durée
              const thisTime = new Date()
              let duration = ((thisTime.getTime() - transDeb.getTime()) / 1000)
              $('#transTime' + elem.pk).html(secToString(duration))
              const timerID = setInterval(function () {
                $('#transTime' + elem.pk).html(secToString(++duration))
              }, 1000)
              $('#transTimer' + elem.pk).html(timerID)
            }
            // Transaction déjà en cours
            $('#transKwh' + elem.pk).html(elem.tsEnergy / 1000)
            $('#transPwrStop' + elem.pk).html('<span class="fw-bold"><%=texts.POWER%>:&nbsp;</span>' + (elem.tsPower / 1000) + '&nbsp;<%=texts.POWERUNIT%>')
          }
        }
      },
      error: function (jqXHR, textStatus, err) {
        alert(jqXHR.responseText)
        clearInterval(interval2)
      }
    });
  }
  // Fonctions autres
  function pad(val) { return val > 9 ? val : "0" + val; }
  function secToString(duration) {
    let seconds = pad(parseInt(duration % 60));
    let minutes = pad(parseInt(duration / 60, 10) % 60);
    let hours = pad(parseInt(duration / 3600, 10));
    return hours + ':' + minutes + ':' + seconds;
  }
</script>
<%- include('./partials/footer.ejs') %>