<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <%- include('./partials/ocpperrors.ejs') %>
  <div class="card">
    <!-- CARD HEADER-->
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs">
        <li class="nav-item">
          <a class="nav-link" href="/site/reports/"><%=texts.CHARGE_SESSION%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/site/reports/auth" aria-current="page"><%=texts.AUTH_ERRORS%></a>
        </li>
      </ul>
    </div>
    <!-- CARD HEADER-->
    <!-- CARD BODY -->
    <div class="card-body">
      <div class="row mb-2">
        <div class="col-md-3">
          <div class="input-group input-group-sm flatpickr">
            <div class="input-group-text"><%=texts.DATE%></div>
            <input type="text" class="form-control" id="dateInput" readonly="readonly" data-input>
            <span class="input-group-text" data-clear><i class="bi bi-calendar2-x"></i></span>
          </div>
        </div>
        <div class="col-md-7" id="myFilter">
          <div class="row">
            <div class="col">
              <div class="input-group input-group-sm">
                <div class="input-group-text"><i class="bi bi-funnel"></i></div>
                <select class="form-control bootstrap-table-filter-control-cb_name">
                  <option value=""><%= texts.ALL_CHARGERS %></option>
                </select>
              </div>
            </div>
            <div class="col">
              <div class="input-group input-group-sm">
                <div class="input-group-text"><i class="bi bi-funnel"></i></div>
                <select class="form-control bootstrap-table-filter-control-idtag">
                  <option value=""><%= texts.ALL_RFID_TAGS %></option>
                </select>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-2 text-end">
          <button type="button" class="btn btn-secondary btn-sm" id="refreshTable"><i
              class="bi bi-arrow-clockwise"></i></button>
          <button type="button" class="btn btn-secondary btn-sm" id="exportTable"><i class="bi bi-download"></i></button>
        </div>
      </div>
      <table class="table table-sm" id="reportstab" data-toggle="table" data-locale="<%=texts.LOCALE%>"
        data-mobile-responsive="true">
        <thead>
          <th data-field="cb_name" data-filter-control="select"><%=texts.STATION%></th>
          <th data-field="method"><%=texts.METHOD%></th>
          <th data-field="idtag" data-filter-control="select"><%=texts.IDTAG%></th>
          <th data-field="ts" data-formatter="tsFormatter"><%=texts.DATETIME%></th>
          <th data-field="resp"><%=texts.RESPONSE%></th>
        </thead>
      </table>
    </div>
    <!-- CARD BODY -->
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script src="/js/btable-filter.min.js"></script>
<script src="/js/jquery-table-export.min.js"></script>
<script src="/js/btable-export.min.js"></script>
<script src="/js/flatpickr.min.js"></script>
<% if (texts.LANG=='fr' ) { %>
<script src="/js/flatpickr-fr.min.js"></script>
<% } %>
<script>
  // Document
  $(document).ready(function () {
    $('#inputErrors').delay(5000).fadeOut('slow');
  });
  // Flatpickr
  const tsnow = new Date()
  const defaultDate = flatpickr.formatDate(tsnow, "D Y-m-d")
  const elem = document.querySelector('div[class$="flatpickr"]');
  const picker = flatpickr(elem, {
    mode: "range",
    maxDate: "today",
    dateFormat: "D Y-m-d",
    defaultDate: [defaultDate, defaultDate],
    wrap: true,
    onClose: function (selectedDates, dateStr, instance) {
      $('#reportstab').bootstrapTable('refresh')
    },
    onChange: function (selectedDates, dateStr, instance) {
      if (dateStr == '') {
        $('#reportstab').bootstrapTable('refresh')
      }
    },
  });
  // BSTable - data-formater
  function tsFormatter(value) {
    let jsdate = new Date(value)
    return jsdate.toLocaleDateString() + ' ' + jsdate.toLocaleTimeString()
  }
  // BootstrapTable
  $(function () {
    $('#reportstab').bootstrapTable('refreshOptions', {
      loadingTemplate: 'loadingTemplate',
      pagination: true,
      pageSize: 50,
      pageList: [50, 100, 250, 'All'],
      ajax: "ajaxRequest",
      queryParams: 'queryParams',
      filterControl: true,
      filterControlContainer: '#myFilter',
      sortSelectOptions: true
    })
  })
  // BSTable - Loading Template
  function loadingTemplate(message) {
    return [
      '<div class="d-flex justify-content-center bsloading"><strong class="me-3 mt-1">',
      message,
      '</strong><div class="spinner-border" role="status" aria-hidden="true"></div></div>'
    ].join('')
  }
  // BSTable - Ajax Query Params
  function queryParams(params) {
    // DatePicker
    if (picker.selectedDates.length == 2) {
      params.start = Math.round(picker.selectedDates[0].getTime())
      params.stop = Math.round(picker.selectedDates[1].getTime() + 86399000)
    } else {
      var d = new Date()
      d.setHours(0, 0, 0, 0)
      params.start = Math.round(d.getTime())
      params.stop = Math.round(params.start + 86399000)
    }
    return params
  }
  // BSTable - Ajax Query
  function ajaxRequest(params) {
    $.ajax({
      type: 'POST',
      url: '/ajax/grantedauthreports_list',
      data: $.param(params.data),
      dataType: 'json',
      success: function (response) {
        params.success(response)
      },
      error: function (er) {
        params.error(er.responseText)
        alert(er.statusText + '\n' + er.responseText)
      }
    });
  }
  // Refresh
  $('#refreshTable').on('click', function (event) {
    event.preventDefault()
    $('#reportstab').bootstrapTable('refresh')
  });
  // Table Export
  $('#exportTable').on('click', function (event) {
    event.preventDefault()
    $('#reportstab').tableExport({
      type: 'csv',
      csvSeparator: ';',
      fileName: 'logsAuthExport'
    });
  });
</script>
<% if (texts.LANG=='fr' ) { %>
<script>
  picker.set('locale', 'fr')
  picker.set('dateFormat', 'D d/m/Y')
</script>
<% } %>
<%- include('./partials/footer.ejs') %>