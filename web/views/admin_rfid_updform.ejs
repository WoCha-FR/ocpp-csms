<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <%- include('./partials/ocpperrors.ejs') %>
  <div class="card mb-3">
    <div class="card-header fs-5 fw-bold"><%=texts.RFID_INFOS%></div>
    <form method="post" action="/admin/rfid/edit">
      <input type="hidden" name="rfpk" value="<%=rfid.rf_pk%>">
      <div class="card-body">
        <div class="row mb-3">
          <!-- Ligne 1 - Colonne 1 -->
          <div class="col-sm-4">
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
              <div class="form-floating">
                <input class="form-control" type="text" name="rftag" value="<%=rfid.idtag%>" id="rftagInput" placeholder="" maxlength="20" required>
                <label for="rftagInput"><%=texts.IDTAG%></label>
              </div>
            </div>
          </div>
          <!-- Ligne 1 - Colonne 2 -->
          <div class="col-sm-4">
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-geo-fill"></i></span>
              <div class="form-floating">
                <select class="form-select" name="rfsite" id="rfsiteInput">
                <% sites.forEach(function(site) { %>
                  <option value="<%=site.s_pk%>"<% if(rfid.site==site.s_pk) { %> selected<% } %>><%=site.s_name%></option>
                <% }) %>
                  <option value=""<% if(!rfid.site) { %> selected<% } %>><%=texts.ALL%></option>
                </select>
                <label for="rfsiteInput"><%=texts.SITE%></label>
              </div>
            </div>
          </div>
          <!-- Ligne 1 - Colonne 3 -->
          <div class="col-sm-4">
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-info-lg"></i></span>
              <div class="form-floating">
                <input class="form-control" type="text" name="rfname" value="<%=rfid.rf_name%>" id="rfnameInput" placeholder="" maxlength="50" required>
                <label for="rfnameInput"><%=texts.CARD_NAME%></label>
              </div>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-4">
            <div class="input-group pt-2">
              <span class="input-group-text"><i class="bi bi-gear"></i></span>
              <input type="radio" class="btn-check" name="rfblocked" value="0" id="rfActive"<% if(!rfid.blocked) { %> checked<% } %>>
              <label class="btn btn-outline-success form-control" for="rfActive"><%=texts.ACCEPTEDF%></label>
              <input type="radio" class="btn-check" name="rfblocked" value="1" id="rfInactive"<% if(rfid.blocked) { %> checked<% } %>>
              <label class="btn btn-outline-danger form-control" for="rfInactive"><%=texts.REJECTEDF%></label>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="input-group flatpickr">
              <span class="input-group-text"><i class="bi bi-hourglass-split"></i></span>
              <div class="form-floating">
                <input class="form-control" type="text" name="rfexpire" readonly="readonly" id="rfdateInput" data-input>
                <label for="rfdateInput"><%=texts.EXPIRE%></label>
              </div>
              <span class="input-group-text" data-clear><i class="bi bi-calendar2-x"></i></span>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-person"></i></span>
              <div class="form-floating">
                <select class="form-select" name="rfuser" id="rfuserInput">
                  <%users.forEach(function(user) { %>
                  <option value="<%=user.user_pk%>" <% if(rfid.user==user.user_pk) { %> selected<% } %>><%=user.name%> (<%=user.usermail%>)</option>
                  <% }) %>
                  <option value=""<% if(!rfid.user) { %> selected<% } %>><%=texts.NONAFFECTE%></option>
                </select>
                <label for="rfuserInput"><%=texts.USER%></label>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="card-footer">
        <a class="btn btn-primary" role="button" href="/admin/rfids"><%=texts.BACK%></a>
        <button class="btn btn-primary" type="submit"><%=texts.SAVE%></button>
      </div>
    </form>
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#inputErrors').delay(5000).fadeOut('slow');
  });
  const rfsite = document.getElementById("rfsiteInput");
  rfsite.addEventListener("change", updateValue)
  function updateValue(e) {
    const params = { rfsite: e.target.value }
    $.ajax({
      url: '/admin/rfids/ajax/updsiteusers',
      type: 'POST',
      data: params,
      dataType: 'json',
      success: function (result) {
        $('#rfuserInput').empty();
        for (const elem of result.data) {
          $('#rfuserInput').append('<option value="' + elem.user_pk + '">' + elem.name + ' ('+ elem.usermail +')</option>');
        }
        $('#rfuserInput').append('<option value="" selected><%=texts.NONAFFECTE%></option>');
      },
      error: function (jqXHR, textStatus, err) {
        alert(jqXHR.responseText)
      }
    });
  }
</script>
<script src="/js/flatpickr.min.js"></script>
<% if (texts.LANG == 'fr') { %>
<script src="/js/flatpickr-fr.min.js"></script>
<script>flatpickr.localize(flatpickr.l10ns.fr);</script>
<% } %>
<script>
  let expire = '<%-rfid.expire%>';
  const elem = document.querySelector('div[class="input-group flatpickr"]');
  const picker = flatpickr(elem, {
    minDate: new Date().fp_incr(1),
    maxDate: new Date().fp_incr(366),
    altInput: true,
    altFormat: "l, d F Y G:i K",
    dateFormat: "U",
    enableTime: true,
    defaultDate: expire,
    wrap: true
  });
</script>
<% if (texts.LANG=='fr') { %>
<script>
  picker.set("altFormat", "l d F Y H:i");
</script>
<% } %>
<%- include('./partials/footer.ejs') %>