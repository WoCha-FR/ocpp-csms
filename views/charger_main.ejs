<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <div class="content-header">
    <div class="container-fluid">
      <h2><%=texts.STATION%> <%= station.cb_name %>
        <% if(station.online==1) { %>
          <span class="badge text-bg-success fs-6"><%=texts.ONLINE%></span>
        <% } else if(station.online==0) { %>
          <span class="badge text-bg-danger fs-6"><%=texts.OFFLINE%></span>
        <% } else { %>
          <span class="badge text-bg-warning fs-6"><%=texts.PENDING%></span>
        <% } %>
      </h2>
    </div>
  </div>
  <%- include('./partials/ocpperrors.ejs') %>
  <% if (typeof infosui.ocppResult !=='undefined' ) { %>
    <% if (infosui.ocppResult.status=='Rejected' ) { %>
        <div id="ocppResponse" class="alert alert-danger" role="alert"><%=texts.REJECTEDM%></div>
    <% } else if(infosui.ocppResult.status=='NotSupported' ) { %>
      <div id="ocppResponse" class="alert alert-warning" role="alert"><%=texts.NOT_SUPPORTED%></div>
    <% } else if(infosui.ocppResult.status=='RebootRequired' ) { %>
      <div id="ocppResponse" class="alert alert-warning" role="alert"><%=texts.REBOOT_REQUIRED%></div>
    <% } else if(infosui.ocppResult.status=='Accepted' ) { %>
      <div id="ocppResponse" class="alert alert-success" role="alert"><%=texts.ACCEPTEDM%></div>
    <% } else if(infosui.ocppResult.status=='Updated' ) { %>
      <div id="ocppResponse" class="alert alert-success" role="alert"><%=texts.UPDATED%></div>
    <% } else if(infosui.ocppResult.status=='Unlocked' ) { %>
      <div id="ocppResponse" class="alert alert-success" role="alert"><%=texts.UNLOCKED%></div>
    <% } else if(infosui.ocppResult.status=='UnlockFailed' ) { %>
      <div id="ocppResponse" class="alert alert-danger" role="alert"><%=texts.UNLOCKFAILED%></div>
    <% } else { %>
      <div id="ocppResponse" class="alert alert-warning" role="alert"><%=infosui.ocppResult.status%></div>
    <% } %>
  <% } %>
  <div class="card">
    <!-- CARD HEADER-->
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs">
        <li class="nav-item">
          <a class="nav-link active" href="/station/<%= station.cb_id %>/"><%=texts.STATION%></a>
        </li>
        <li>
          <a class="nav-link" href="/station/<%= station.cb_id %>/manage"><%=texts.MANAGE%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/station/<%= station.cb_id %>/logs"><%=texts.LOGS%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/station/<%= station.cb_id %>/ocppkeys"><%=texts.CONFIG_OCPP%></a>
        </li>
      </ul>
    </div>
    <!-- CARD HEADER-->
    <!-- CARD BODY -->
    <div class="card-body">
      <% if(conns.length==0 || station.online==2) { %>
        <div class="row p-2"><%=texts.PENDING%></div>
      <% } %>
    <!-- CONNECTORS ARRAY -->
    <% conns.forEach(function(conn) { %>
      <div class="card h-100">
        <div class="card-header">
          <% if (conn.status=='Unavailable' || conn.status=='Faulted') { %>
            <span class="badge text-bg-secondary fs-6"><i class="bi bi-ev-station"></i>
            &nbsp;<%=texts.CONNECTOR%>&nbsp;<%= conn.connector_id %></span>
          <% } else if (conn.status=='Available') { %>
            <span class="badge text-bg-success fs-6"><i class="bi bi-ev-station"></i>
            &nbsp;<%=texts.CONNECTOR%>&nbsp;<%= conn.connector_id %></span>
          <% } else if (conn.status=='Charging') { %>
            <span class="badge text-bg-danger fs-6"><i class="bi bi-ev-station"></i>
            &nbsp;<%=texts.CONNECTOR%>&nbsp;<%= conn.connector_id %></span>
          <% } else { %>
            <span class="badge text-bg-warning fs-6"><i class="bi bi-ev-station"></i>
            &nbsp;<%=texts.CONNECTOR%>&nbsp;<%= conn.connector_id %></span>
          <% } %><!-- TODO Conn Status-->
          <div class="float-end"><%= conn.status %></div>
        </div>
        <div class="card-body">
          <div class="container-fluid text-center">
            <div class="row">
              <div class="col-sm-2">
                <form action="/station/<%= station.cb_id %>/remotestart" method="post">
                  <input type="hidden" id="connectorId<%= conn.connector_id %>" name="connectorId" value="<%= conn.connector_id %>">
                  <button type="submit" id="remoteStart<%= conn.connector_id %>" class="btn btn-info btn-sm mb-2 w-100">
                    <%=texts.START_CHARGING%>
                  </button>
                </form>
                <form action="/station/<%= station.cb_id %>/remotestop" method="post">
                  <input type="hidden" id="transId<%= conn.connector_id %>" name="transId" value="<%= conn.connector_id %>">
                  <button type="submit" id="remoteStop<%= conn.connector_id %>" class="btn btn-info btn-sm mb-2 w-100">
                    <%=texts.STOP_CHARGING%>
                  </button>
                </form>
                <form action="/station/<%= station.cb_id %>/unlockconnector" method="post">
                  <input type="hidden" id="connectorId<%= conn.connector_id %>" name="connectorId" value="<%= conn.connector_id %>">
                  <button type="submit" id="UnlockConn<%= conn.connector_id %>" class="btn btn-info btn-sm w-100">
                    <%=texts.UNLOCK_CONN%>
                  </button>
                </form>
              </div>
              <div class="col">COL</div>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
    <!-- CONNECTORS ARRAY -->
    </div>
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#ocppResponse').delay(3000).fadeOut('slow');
    $('#inputErrors').delay(5000).fadeOut('slow');
  });
</script>
<% if(station.online!=1) { %>
<script>
  $(document).ready(function () {
    $('#softReset').prop('disabled', true);
    $('#hardReset').prop('disabled', true);
    $('#setOperative').prop('disabled', true);
    $('#setInoperative').prop('disabled', true);
    $('#reqBoot').prop('disabled', true);
    $('#reqBeat').prop('disabled', true);
    $('#reqStatus').prop('disabled', true);
    $('#reqMeter').prop('disabled', true);
  });
</script>
<% } %>
<%- include('./partials/footer.ejs') %>