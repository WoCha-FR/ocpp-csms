<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <%- include('./partials/ocpperrors.ejs') %>
  <% if (typeof infosui.ocppResult !=='undefined' ) { %>
    <% if (infosui.ocppResult.status=='Rejected' ) { %><div id="ocppResponse" class="alert alert-danger" role="alert"><%=texts.REJECTEDM%></div>
    <% } else if(infosui.ocppResult.status=='NotSupported' ) { %><div id="ocppResponse" class="alert alert-warning" role="alert"><%=texts.NOT_SUPPORTED%></div>
    <% } else if(infosui.ocppResult.status=='Accepted' ) { %><div id="ocppResponse" class="alert alert-success" role="alert"><%=texts.ACCEPTEDM%></div>
    <% } else { %><div id="ocppResponse" class="alert alert-warning" role="alert"><%=infosui.ocppResult.status%></div><% } %>
  <% } %>
  <% if (charger.online==0) { %>
    <div class="alert alert-warning" role="alert">OFFLINE</div>
  <% } %>
  <div class="card">
    <div class="card-header">
      <div class="float-start"><a href="/mydashboard" class="link-secondary"><i class="bi bi-caret-left-square-fill fs-5"></i></a></div>
      <div class="flex-grow-1 fs-5 fw-bold text-center"><%= charger.cb_name %></div>
    </div>
    <div class="card-body">
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4"><% connectors.forEach(function(elem) { %>
        <div class="col">
          <div class="card h-100">
            <div class="card-header text-center">
              <small class="d-inline-flex mb-0 px-2 py-1 fw-bold text-white bg-secondary border border-secondary rounded-2">
                <i class="bi bi-plugin"></i>&nbsp;<%=elem.connector_id%>&nbsp;:&nbsp;<%- elem.cname ? elem.cname : texts.CONNECTOR + ' ' + elem.connector_id%>
              </small>
            </div>
            <div class="card-body">
              <div class="row pb-1 border-bottom">
                <div class="col text-start"><%=texts.STATE%></div>
                <div class="col text-end">
                  <!--TODO: STATUS SELON CHARGE DE L'UTILISATEUR OU D'UNE AUTRE UTILISATEUR-->
                  <% if (elem.status=='Unavailable' || elem.status=='Faulted' ) { %>
                  <span class="badge text-bg-danger"><%=elem.status%></span>
                  <% } else if (elem.status=='Available' ) { %>
                  <span class="badge text-bg-success"><%=elem.status%></span>
                  <% } else if (elem.status=='Charging' ) { %>
                  <span class="badge text-bg-info"><%=elem.status%></span>
                  <% } else { %>
                  <span class="badge text-bg-warning"><%=elem.status%></span>
                  <% } %>
                </div>
              </div>
              <div class="row pb-1 border-bottom">
                <div class="col text-start"><%=texts.MAX_POWER%></div>
                <div class="col text-end fw-bold"><%=elem.maxPower%>&nbsp;<%=texts.POWERUNIT%></div>
              </div>
              <div class="row pb-1 border-bottom">
                <div class="col text-start"><%=texts.FORMAT%></div>
                <div class="col text-end fw-bold">
                  <% if (elem.format==1) { %><%=texts.CONNECTOR_SOCKET%><%} %>
                  <% if (elem.format==2) { %><%=texts.CONNECTOR_CABLE%><%} %>
                </div>
              </div>
              <div class="row pb-1 border-bottom">
                <div class="col text-start"><%=texts.TYPE%></div>
                <div class="col text-end fw-bold">
                  <% if (elem.type==1) { %>Type 2<% } %>
                  <% if (elem.type==2) { %>Combo CCS<% } %>
                  <% if (elem.type==3) { %>Type 1<% } %>
                  <% if (elem.type==4) { %>CHAdeMO<% } %>
                </div>
              </div>
              <!--TODO: BTN to start OR Charging status + stop BTN-->
              <div class="row mt-2">
                <div class="col-12 text-center">
                  <form action="/charger/<%=elem.cb_id%>/start" method="post" id="btnStart<%=elem.pk%>" class="<% if(elem.status!='Available' && elem.status!='Preparing' ) { %>d-none<% } %>">
                    <input type="hidden" id="connectorId<%=elem.pk%>" name="connectorId" value="<%=elem.connector_id%>">
                    <button type="submit" id="remoteStart<%=elem.pk%>" class="btn btn-success btn-sm w-100 ocppReq<%=elem.pk%>" <%
                      if(charger.online!==1) { %> disabled<% } %>>
                        <%=texts.START_CHARGING%>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div><% }); //FOREACH %>
      </div>
    </div>
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#inputErrors').delay(5000).fadeOut('slow');
    $('#ocppResponse').delay(3000).fadeOut('slow');
  });
</script>
<%- include('./partials/footer.ejs') %>