<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <%- include('./partials/ocpperrors.ejs') %>
  <!-- User Account Information Card -->
  <div class="card mb-2">
    <div class="card-header fs-5 fw-bold"><%=userInfo.usermail%></div>
    <form method="post" action="/compte">
      <div class="card-body">
        <div class="row justify-content-start">
          <div class="col-sm-4">
            <label for="unameInput" class="form-label fw-bold"><%=texts.USER%></label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-person"></i></span>
              <input class="form-control" type="text" name="uname" value="<%=userInfo.name%>" id="unameInput"
                aria-describedby="unameHelpBlock" required>
            </div>
            <div id="unameHelpBlock" class="form-text"><%=texts.USERNAME_INFOS%></div>
          </div>
          <div class="col-sm-4">
            <label for="upassInput1" class="form-label fw-bold"><%=texts.NEWPASSWORD%></label>
            <div class="input-group" id="show_hide_password1">
              <span class="input-group-text"><i class="bi bi-key"></i></span>
              <input class="form-control" type="password" name="password" id="upassInput1" aria-describedby="upassHelpBlock"
                placeholder="">
              <span class="input-group-text"><a href="" class="nav-link"><i class="bi bi-eye-slash"></i></a></span>
            </div>
            <div id="upassHelpBlock" class="form-text"><%=texts.USERPASS_INFOS%></div>
          </div>
          <div class="col-sm-4">
            <label for="upassInput2" class="form-label fw-bold"><%=texts.CONFIRMPASSWORD%></label>
            <div class="input-group" id="show_hide_password2">
              <span class="input-group-text"><i class="bi bi-key"></i></span>
              <input class="form-control" type="password" name="password2" id="upassInput2" placeholder="">
              <span class="input-group-text"><a href="" class="nav-link"><i class="bi bi-eye-slash"></i></a></span>
            </div>
          </div>
        </div>
      </div>
      <div class="card-footer">
        <button class="btn btn-primary" type="submit"><%=texts.SAVE%></button>
      </div>
    </form>
  </div>
  <!-- User Notifications Card -->
  <div class="card mb-2">
    <div class="card-header fs-5 fw-bold"><%=texts.MYNOTIFS%></div>
    <form method="post" action="/compte/notifications">
      <div class="card-body">
        <div class="row mb-2 align-items-center">
          <div class="col-12 col-sm-2">
            <div class="form-floating">
              <select class="form-select form-select-sm" id="langSelect" name="lang">
                <option value="fr" <%=userNotifs.lng === 'fr' ? 'selected' : '' %>>Français</option>
                <option value="en" <%=userNotifs.lng === 'en' ? 'selected' : '' %>>English</option>
              </select>
              <label for="langSelect"><%=texts.LANGUAGE%></label>
            </div>
          </div>
          <div class="col-12 col-sm-2">
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="emailSwitch" value="1" name="emailNotifs"
                <%=userNotifs.mailEnabled ? 'checked' : '' %>>
              <label class="form-check-label" for="emailSwitch"><%=texts.EMAILNOTIFICATIONS%></label>
            </div>
          </div>
          <div class="col-12 col-sm-2">
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="pushSwitch" value="1" name="pushNotifs"
                <%=userNotifs.pushEnabled ? 'checked' : '' %>>
              <label class="form-check-label" for="pushSwitch"><%=texts.PUSHNOTIFICATIONS%></label>
            </div>
          </div>
          <div class="col-12 col-sm-3">
            <div class="form-floating">
              <input type="text" class="form-control form-control-sm" id="pushoverUserInput" name="pushUser" value="<%=userNotifs.pushuser%>">
              <label for="pushoverUserInput"><%=texts.PUSHUSERKEY%></label>
            </div>
          </div>
          <div class="col-12 col-sm-3">
            <div class="form-floating">
              <input type="text" class="form-control form-control-sm" id="pushoverTokenInput" name="pushToken" value="<%=userNotifs.pushtokn%>">
              <label for="pushoverTokenInput"><%=texts.PUSHTOKEN%></label>
            </div>
          </div>
        </div>
        <% if (userInfo.isAdmin || userInfo.isOwner) { %>
        <div class="row mb-2">
          <div class="col-12 col-sm-2">
            <strong><%=texts.NOTIFSMYSTATIONS%>:</strong>
          </div>
          <div class="col-12 col-sm-10">
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="cbOnlineSwitch" value="1" name="cbOnline"
                <%=userNotifs.cbOnline ? 'checked' : '' %>>
              <label class="form-check-label" for="cbOnlineSwitch"><%=texts.CBONLINE%></label>
            </div>
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="cbOfflineSwitch" value="1" name="cbOffline"
                <%=userNotifs.cbOffline ? 'checked' : '' %>>
              <label class="form-check-label" for="cbOfflineSwitch"><%=texts.CBOFFLINE%></label>
            </div>
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="conFaultedSwitch" value="1" name="conFaulted"
                <%=userNotifs.conFaulted ? 'checked' : '' %>>
              <label class="form-check-label" for="conFaultedSwitch"><%=texts.CONFAULTED%></label>
            </div>
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="conAvailableSwitch" value="1" name="conAvailable"
                <%=userNotifs.conAvailable ? 'checked' : '' %>>
              <label class="form-check-label" for="conAvailableSwitch"><%=texts.CONAVAILABLE%></label>
            </div>
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="conUnavailableSwitch" value="1" name="conUnavailable"
                <%=userNotifs.conUnavailable ? 'checked' : '' %>>
              <label class="form-check-label" for="conUnavailableSwitch"><%=texts.CONUNAVAILABLE%></label>
            </div>
          </div>
        </div>
        <% } %>
        <div class="row">
          <div class="col-12 col-sm-2">
            <strong><%=texts.NOTIFSMYCHARGE%>:</strong>
          </div>
          <div class="col-12 col-sm-10">
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="chgStartSwitch" value="1" name="chgStart"
                <%=userNotifs.chgStart ? 'checked' : '' %>>
              <label class="form-check-label" for="chgStartSwitch"><%=texts.CHARGE_START%></label>
            </div>
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="chgStopSwitch" value="1" name="chgStop"
                <%=userNotifs.chgStop ? 'checked' : '' %>>
              <label class="form-check-label" for="chgStopSwitch"><%=texts.CHARGE_STOP%></label>
              </label>
            </div>
            <div class="form-check form-switch form-check-inline">
              <input class="form-check-input" type="checkbox" id="chgEventSwitch" value="1" name="chgEvent"
                <%=userNotifs.chgEvent ? 'checked' : '' %>>
              <label class="form-check-label" for="chgEventSwitch"><%=texts.CHARGE_EVENTS%></label>
            </div>
          </div>
        </div>
      </div>
      <div class="card-footer">
        <button class="btn btn-primary" type="submit"><%=texts.SAVE%></button>
      </div>
    </form>
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#inputErrors').delay(5000).fadeOut('slow');
    $("#show_hide_password1 a").on('click', function (event) {
      event.preventDefault();
      if ($('#show_hide_password1 input').attr("type") == "text") {
        $('#show_hide_password1 input').attr('type', 'password');
        $('#show_hide_password1 i').addClass("bi-eye-slash");
        $('#show_hide_password1 i').removeClass("bi-eye");
      } else {
        $('#show_hide_password1 input').attr('type', 'text');
        $('#show_hide_password1 i').removeClass("bi-eye-slash");
        $('#show_hide_password1 i').addClass("bi-eye");
      }
    });
    $("#show_hide_password2 a").on('click', function (event) {
      event.preventDefault();
      if ($('#show_hide_password2 input').attr("type") == "text") {
        $('#show_hide_password2 input').attr('type', 'password');
        $('#show_hide_password2 i').addClass("bi-eye-slash");
        $('#show_hide_password2 i').removeClass("bi-eye");
      } else {
        $('#show_hide_password2 input').attr('type', 'text');
        $('#show_hide_password2 i').removeClass("bi-eye-slash");
        $('#show_hide_password2 i').addClass("bi-eye");
      }
    });
  });
</script>
<%- include('./partials/footer.ejs') %>