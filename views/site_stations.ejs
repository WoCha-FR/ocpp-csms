<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <%- include('./partials/ocpperrors.ejs') %>
  <div class="card mb-3">
    <div class="card-header fs-5 fw-bold"><%=texts.STATIONS%></div>
    <div class="card-body">
      <!-- TABLE -->
      <div class="card p-3">
        <table id="stationstable" class="table table-striped table-hover" data-toggle="table" data-search="true"
          data-locale="<%=texts.LOCALE%>" data-mobile-responsive="true" data-search-align="left" data-search-highlight="true"
          data-show-search-button="true">
          <thead>
            <tr>
              <th data-sortable="true" data-field="name"><%=texts.NOM%></th>
              <th data-sortable="true" data-field="regstatus"><%=texts.OCPP_STATUS%></th>
              <th><%=texts.ONLINE%></th>
            </tr>
          </thead>
          <tbody>
            <% if(stations.length> 0) { %>
            <% stations.forEach(function(station) { %>
              <tr style="cursor: pointer;">
                <td><%= station.cb_name %></td>
                <td data-searchable="false" id="status<%=station.cb_pk%>">
                  <% if(station.registration_status=='Rejected') { %>
                  <span class="badge text-bg-danger"><%=texts.REJECTEDF%></span>
                  <% } else if(station.registration_status=='Pending') { %>
                  <span class="badge text-bg-warning"><%=texts.PENDING%></span>
                  <% } else { %>
                  <span class="badge text-bg-success"><%=texts.ACCEPTEDF%></span>
                  <% } %>
                </td>
                <td data-searchable="false" id="online<%=station.cb_pk%>">
                  <% if(station.online==1) { %>
                  <span class="badge text-bg-success"><%=texts.ONLINE%></span>
                  <% } else if(station.online==0) { %>
                  <span class="badge text-bg-danger"><%=texts.OFFLINE%></span>
                  <% } else { %>
                  <span class="badge text-bg-warning"><%=texts.PENDING%></span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
      <!-- TABLE -->
    </div>
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#inputErrors').delay(5000).fadeOut('slow');
    $('#stationstable').removeClass('table-bordered');
  });
  // Click to Station page
  $('#stationstable').on('click-row.bs.table', function (e, row) {
    window.location.href = '/station/' + row.ocppid;
  });
  // Refresh Stations Online Status
  var interval = setInterval(reloadConnStatus, 2500);
  function reloadConnStatus() {
    $.ajax({
      url: '/ajax/stations_status',
      type: 'POST',
      dataType: 'json',
      success: function (result) {
        for (const elem of result.data) {
          var online = '#online' + elem.cb_pk
          if (elem.online == 1) {
            $(online).html('<span class="badge text-bg-success"><%=texts.ONLINE%></span>')
          } else if (elem.online == 0) {
            $(online).html('<span class="badge text-bg-danger"><%=texts.OFFLINE%></span>')
          } else {
            $(online).html('<span class="badge text-bg-warning"><%=texts.PENDING%></span>')
          }
          var status = '#status' + elem.cb_pk
          if (elem.registration_status == 'Rejected') {
            $(status).html('<span class="badge text-bg-danger"><%=texts.REJECTEDF%></span>')
          } else if (elem.registration_status == 'Pending') {
            $(status).html('<span class="badge text-bg-warning"><%=texts.PENDING%></span>')
          } else {
            $(status).html('<span class="badge text-bg-success"><%=texts.ACCEPTEDF%></span>')
          }
        }
      },
      error: function (jqXHR, textStatus, err) {
        alert(jqXHR.responseText)
        clearInterval(interval)
      }
    });
  }
</script>
<%- include('./partials/footer.ejs') %>