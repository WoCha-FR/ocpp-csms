<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row justify-content-md-left">
        <div class="col-md-auto fs-2"><%=texts.STATION%>&nbsp;<%= station.cb_name %></div>
      </div>
    </div>
  </div>
  <%- include('./partials/ocpperrors.ejs') %>
  <% if (typeof infosui.ocppResult !=='undefined' ) { %>
    <% if (infosui.ocppResult.status=='Rejected' ) { %>
      <div id="ocppResponse" class="alert alert-danger" role="alert"><%=texts.REJECTEDM%></div>
    <% } else if(infosui.ocppResult.status=='NotSupported' ) { %>
      <div id="ocppResponse" class="alert alert-warning" role="alert"><%=texts.NOT_SUPPORTED%></div>
    <% } else if(infosui.ocppResult.status=='RebootRequired' ) { %>
      <div id="ocppResponse" class="alert alert-warning" role="alert"><%=texts.REBOOT_REQUIRED%></div>
    <% } else if(infosui.ocppResult.status=='Accepted' ) { %>
      <div id="ocppResponse" class="alert alert-success" role="alert"><%=texts.ACCEPTEDM%></div>
    <% } else if(infosui.ocppResult.status=='Updated' ) { %>
      <div id="ocppResponse" class="alert alert-success" role="alert"><%=texts.UPDATED%></div>
    <% } else { %>
      <div id="ocppResponse" class="alert alert-warning" role="alert"><%=infosui.ocppResult.status%></div>
    <% } %>
  <% } %>
  <div class="card">
    <!-- CARD HEADER-->
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs">
        <li>
          <a class="nav-link active" href="/charger/<%=station.cb_id%>"><%=texts.STATION%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/charger/<%=station.cb_id%>/connectors"><%=texts.CONNECTORS%></a>
        </li>
        <% if (userInfo.isAdmin == 1) { %>
        <li class="nav-item">
          <a class="nav-link" href="/charger/<%=station.cb_id%>/logs"><%=texts.LOGS%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/charger/<%=station.cb_id%>/ocppconfig"><%=texts.CONFIG_OCPP%></a>
        </li>
        <% } %>
      </ul>
    </div><!-- CARD HEADER-->
    <!-- CARD BODY -->
    <div class="card-body">
      <!-- FIRST LINE-->
      <div class="row p-1">
        <!-- BOOT INFOS DATA -->
        <div class="col-12 col-sm-6">
          <div class="card h-100">
            <div class="card-header fs-6 fw-bold"><%=texts.STATION_INFOS%></div>
            <div class="card-body">
              <% if(typeof cbinfos==='undefined' || station.online==2) { %>
                <div class="row p-1">
                  <div class="col" id="online">
                    <span class="fw-bold"><%=texts.ONLINE%>:&nbsp;</span>
                    <span class="badge text-bg-warning"><%=texts.PENDING%></span>
                  </div>
                </div>
              <% } else { %>
                <div class="row p-1">
                  <div class="col" id="online"><span class="fw-bold"><%=texts.ONLINE%>:&nbsp;</span>
                    <% if(station.online==1) { %>
                    <span class="badge text-bg-success"><%=texts.ONLINE%></span>
                    <% } else if(station.online==0) { %>
                    <span class="badge text-bg-danger"><%=texts.OFFLINE%></span>
                    <% } else { %>
                    <span class="badge text-bg-warning"><%=texts.PENDING%></span>
                    <% } %>
                  </div>
                  <div class="col"></div>
                </div>
                <div class="row p-1">
                  <div class="col"><span class="fw-bold"><%=texts.FABRICANT%>:&nbsp;</span><%=cbinfos.cp_vendor%></div>
                  <% let date=new Date(station.last_bootnotif_ts * 1000) %>
                  <div class="col" id="lastboot"><span class="fw-bold"><%=texts.LASTBOOT%>:&nbsp;</span><%= date.toLocaleDateString(texts.LOCALE) %>&nbsp;<%= date.toLocaleTimeString(texts.LOCALE) %></div>
                </div>
                <div class="row p-1">
                  <div class="col"><span class="fw-bold"><%=texts.MODELE%>:&nbsp;</span><%=cbinfos.cp_model%></div>
                  <% let date2=new Date(station.last_heartbeat_ts * 1000) %>
                  <div class="col" id="lastheart"><span class="fw-bold"><%=texts.LASTHEART%>:&nbsp;</span><%= date2.toLocaleDateString(texts.LOCALE) %>&nbsp;<%= date2.toLocaleTimeString(texts.LOCALE) %></div>
                </div>
                <div class="row p-1">
                  <div class="col"><span class="fw-bold"><%=texts.SERIAL%>:&nbsp;</span><%=cbinfos.cp_serial_number%></div>
                  <div class="col"><span class="fw-bold"><%=texts.ENDPOINT%>:&nbsp;</span><%=cbinfos.endpoint_address%></div>
                </div>
                <div class="row p-1">
                  <div class="col"><span class="fw-bold"><%=texts.FIRMWARE%>:&nbsp;</span><%=cbinfos.fw_version%></div>
                  <div class="col"><span class="fw-bold"><%=texts.ICCID%>:&nbsp;</span><%=cbinfos.iccid%></div>
                </div>
                <div class="row p-1">
                  <div class="col"><span class="fw-bold"><%=texts.METERTYPE%>:&nbsp;</span><%=cbinfos.meter_type%></div>
                  <div class="col"><span class="fw-bold"><%=texts.IMSI%>:&nbsp;</span><%=cbinfos.imsi%></div>
                </div>
              <% } %>
            </div>
          </div>
        </div><!-- BOOT INFOS DATA -->
        <div class="col-sm-6"><!--Seconde Colonne : 2 Lignes-->
          <div class="row mb-2">
            <!-- STATION FORM -->
            <div class="col-12 col-sm-12">
              <div class="card">
                <div class="card-header fs-6 fw-bold"><%=texts.STATION_PERSO%></div>
                <form method="post" action="/charger/<%= station.cb_id %>/update">
                  <div class="card-body">
                    <div class="row">
                      <div class="col-sm-6">
                        <div class="input-group">
                          <span class="input-group-text"><i class="bi bi-ev-station-fill"></i></span>
                          <div class="form-floating">
                            <input class="form-control" type="text" name="cbname" id="unameInput" placeholder=""
                              value="<%=station.cb_name%>" required>
                            <label for="unameInput"><%=texts.STATION_NAME%></label>
                          </div>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="input-group">
                          <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                          <div class="form-floating">
                            <select class="form-select" name="cbmode" id="cbmodeInput">
                              <option value="0" <% if(station.cb_mode==0) { %> selected<% } %>><%=texts.FREE_CHARGE_OCPP%>
                              </option>
                              <option value="2" <% if(station.cb_mode==2) { %> selected<% } %>><%=texts.FREE_CHARGE_BORNE%>
                              </option>
                              <option value="1" <% if(station.cb_mode==1) { %> selected<% } %>><%=texts.RESTRICTED_CHARGE%>
                              </option>
                            </select>
                            <label for="cbmodeInput"><%=texts.CHARGEAUTH_MODE%></label>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="card-footer">
                    <button class="btn btn-primary btn-sm" type="submit"><%=texts.UPDATE%></button>
                  </div>
                </form>
              </div>
            </div><!-- STATION FORM -->
          </div>
          <div class="row">
            <!-- ROW RESET STATION-->
            <div class="col-12 col-sm-6">
              <div class="card">
                <div class="card-header fs-6 fw-bold"><%=texts.RESET%></div>
                <div class="card-body text-center">
                  <form action="/charger/<%= station.cb_id %>/reboot" method="post">
                    <button type="submit" name="ResetType" value="Soft" class="btn btn-success btn-sm ocppReq">
                      <%=texts.SOFT%>
                    </button>
                    <button type="submit" name="ResetType" value="Hard" class="btn btn-danger btn-sm ocppReq">
                      <%=texts.HARD%>
                    </button>
                  </form>
                </div>
              </div>
            </div><!-- ROW RESET STATION-->
            <!-- ROW DISPO STATION-->
            <div class="col-12 col-sm-6">
              <div class="card">
                <div class="card-header fs-6 fw-bold"><%=texts.AVAILABILITY%></div>
                <div class="card-body text-center">
                  <form action="/charger/<%= station.cb_id %>/available" method="post">
                    <input type="hidden" id="connectorId" name="connectorId" value="0">
                    <button type="submit" name="AvailabilityType" value="Operative"
                      class="btn btn-success btn-sm ocppReq">
                      <%=texts.OPERATIVE%>
                    </button>
                    <button type="submit" name="AvailabilityType" value="Inoperative"
                      class="btn btn-danger btn-sm ocppReq">
                      <%=texts.INOPERATIVE%>
                    </button>
                  </form>
                </div>
              </div>
            </div><!-- ROW DISPO STATION-->
          </div>
        </div><!--Seconde Colonne : 2 Lignes-->
      </div><!-- FIRST LINE-->
      <!-- SECOND LINE -->
      <% if (userInfo.isAdmin==1) { %>
      <div class="row p-1">
        <!-- ROW REQUEST STATION-->
        <div class="col-12 col-sm-12">
          <div class="card">
            <div class="card-header fs-6 fw-bold"><%=texts.REQUEST_MESSAGE%></div>
            <div class="card-body text-center">
              <form action="/charger/<%= station.cb_id %>/request" method="post">
                <input type="hidden" id="connectorId" name="connectorId" value="0">
                <button type="submit" name="requestedMessage" value="BootNotification"
                  class="btn btn-secondary btn-sm ocppReq">BootNotification</button>
                <button type="submit" name="requestedMessage" value="Heartbeat"
                  class="btn btn-secondary btn-sm ocppReq">Heartbeat</button>
                <button type="submit" name="requestedMessage" value="StatusNotification"
                  class="btn btn-secondary btn-sm ocppReq">StatusNotification</button>
                <button type="submit" name="requestedMessage" value="MeterValues"
                  class="btn btn-secondary btn-sm ocppReq">MeterValues</button>
              </form>
            </div>
          </div>
        </div><!-- ROW REQUEST STATION-->
      </div><!-- SECOND LINE -->
      <% } %>
      <!-- CONNECTORS LINES -->
      <% conns.forEach(function(conn) { %>
      <div class="row p-1">
        <div class="col">
          <div class="card">
            <div class="card-header fs-6 fw-bold"><%=texts.CONNECTOR%>&nbsp;<%=conn.connector_id%></div>
            <div class="card-body">
              <div class="row mb-2">
                <div class="col-4">
                  <div class="card h-100">
                    <div class="card-header fs-6 fw-bold"><%=texts.CONNECTOR_INFOS%></div>
                    <div class="card-body">
                      <div class="row p-1">
                        <div class="col-7" id="connstatus<%=conn.connector_id%>">
                          <span class="fw-bold"><%=texts.AVAILABILITY%>:&nbsp;</span>
                          <% if(conn.status=='Unavailable' ) { %>
                          <span class="badge text-bg-warning"><%=texts.INOPERATIVEM%></span>
                          <% } else if(conn.status=='Faulted' ) { %>
                          <span class="badge text-bg-danger"><%=texts.FAULTY%></span>
                          <% } else { %>
                          <span class="badge text-bg-success"><%=texts.OPERATIVEM%></span>
                          <% } %>
                        </div>
                        <div class="col-5 text-end">
                          <form action="/charger/<%= station.cb_id %>/available" method="post">
                            <input type="hidden" id="connectorId" name="connectorId" value="<%=conn.connector_id%>">
                            <button type="submit" name="AvailabilityType" value="Operative" class="btn btn-success btn-sm ocppReq"><%=texts.OPERATIVEM%></button>
                            <button type="submit" name="AvailabilityType" value="Inoperative" class="btn btn-danger btn-sm ocppReq"><%=texts.INOPERATIVEM%></button>
                          </form>
                        </div>
                      </div>
                      <div class="row p-1">
                        <div class="col-7" id="connlaststatus<%=conn.connector_id%>">
                          <span class="fw-bold"><%=texts.LASTSTATUS%>:&nbsp;</span>
                          <% let date3=new Date(conn.status_ts * 1000) %>
                          <%= date3.toLocaleDateString(texts.LOCALE) %>&nbsp;<%= date3.toLocaleTimeString(texts.LOCALE) %>
                        </div>
                        <div class="col-5 text-end">
                          <form action="/charger/<%= station.cb_id %>/reqconnector" method="post">
                            <input type="hidden" id="connectorId" name="connectorId" value="<%= conn.connector_id %>">
                            <button type="submit" id="reqStatus" name="requestedMessage" value="StatusNotification"
                              class="btn btn-secondary btn-sm ocppReq">StatusNotification</button>
                          </form>
                        </div>
                      </div>
                      <div class="row p-1">
                        <div class="col-7" id="connmeter<%=conn.connector_id%>">
                          <span class="fw-bold"><%=texts.METERINDEX%>:&nbsp;</span>
                          <%=(conn.energy/1000)%>&nbsp;<%=texts.ENERGYUNIT%>
                        </div>
                        <div class="col-5 text-end">
                          <form action="/charger/<%=station.cb_id%>/reqconnector" method="post">
                            <input type="hidden" id="connectorId" name="connectorId" value="<%= conn.connector_id %>">
                            <button type="submit" id="reqMeter" name="requestedMessage" value="MeterValues"
                              class="btn btn-secondary btn-sm ocppReq">MeterValues</button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-8">
                  <form class="h-100" method="post" action="/charger/<%= station.cb_id %>/updconnector">
                    <input type="hidden" id="connectorId" name="connectorId" value="<%= conn.connector_id %>">
                    <div class="card h-100">
                      <div class="card-header fs-6 fw-bold"><%=texts.CONNECTOR_PERSO%></div>
                      <div class="card-body">
                        <div class="row">
                          <div class="col-3">
                            <div class="input-group">
                              <span class="input-group-text"><i class="bi bi-speedometer2"></i></span>
                              <div class="form-floating">
                                <input class="form-control" type="number" name="cmaxp" id="cmaxpInput" min="1" max="400" value="<%=conn.maxPower%>" required>
                                <label for="cmaxpInput"><%=texts.MAX_POWER%></label>
                              </div>
                              <span class="input-group-text"><%=texts.POWERUNIT%></span>
                            </div>
                          </div>
                          <div class="col-3">
                              <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-info-lg"></i></span>
                                <div class="form-floating">
                                  <select class="form-select" name="cformat" id="cformatInput">
                                    <option value="1" <% if(conn.format==1) { %> selected<% } %>><%=texts.CONNECTOR_SOCKET%>
                                    </option>
                                    <option value="2" <% if(conn.format==2) { %> selected<% } %>><%=texts.CONNECTOR_CABLE%>
                                    </option>
                                  </select>
                                  <label for="cformatInput"><%=texts.CONNECTOR_FORMAT%></label>
                                </div>
                              </div>
                          </div>
                          <div class="col-3">
                              <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-gear"></i></span>
                                <div class="form-floating">
                                  <select class="form-select" name="ctype" id="ctypeInput">
                                    <option value="1" <% if(conn.type==1) { %> selected<% } %>>Type 2</option>
                                    <option value="2" <% if(conn.type==2) { %> selected<% } %>>Combo CCS</option>
                                    <option value="3" <% if(conn.type==3) { %> selected<% } %>>Type 1</option>
                                    <option value="4" <% if(conn.type==4) { %> selected<% } %>>CHAdeMO</option>
                                  </select>
                                  <label for="ctypeInput">
                                    <%=texts.CONNECTOR_TYPE%>
                                  </label>
                                </div>
                              </div>
                          </div>
                          <div class="col-3">
                              <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-plugin"></i></span>
                                <div class="form-floating">
                                  <input class="form-control" type="text" name="cname" id="cnameInput" value="<%=conn.cname%>">
                                  <label for="cnameInput">
                                    <%=texts.CONNECTOR_NAME%>
                                  </label>
                                </div>
                              </div>
                          </div>
                        </div>
                      </div>
                      <div class="card-footer">
                        <button class="btn btn-primary btn-sm" type="submit">
                          <%=texts.UPDATE%>
                        </button>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% }); %>
    </div><!-- CARD BODY -->
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#ocppResponse').delay(3000).fadeOut('slow');
    $('#inputErrors').delay(5000).fadeOut('slow');
  });
  // Refresh Charger Data
  var interval1 = setInterval(reloadChargerStatus, 2500);
  function reloadChargerStatus() {
    $.ajax({
      url: '/ajax/charger_status',
      type: 'POST',
      data: { ocppName: '<%= station.cb_id %>'},
      dataType: 'json',
      success: function (result) {
        if (result.data.online === 1) {
          $('#online').html('<span class="fw-bold"><%=texts.ONLINE%>:</span>&nbsp;<span class="badge text-bg-success"><%=texts.ONLINE%></span>');
          $('.ocppReq').prop('disabled', false);
        } else {
          $('.ocppReq').prop('disabled', true);
          if (result.data.online === 0) {
            $('#online').html('<span class="fw-bold"><%=texts.ONLINE%>:</span>&nbsp;<span class="badge text-bg-danger"><%=texts.OFFLINE%></span>')
          } else {
            $('#online').html('<span class="fw-bold"><%=texts.ONLINE%>:</span>&nbsp;<span class="badge text-bg-warning"><%=texts.PENDING%></span>')
          }
        }
        // Boot TS
        let dateb = new Date(result.data.last_bootnotif_ts * 1000)
        $('#lastboot').html('<span class="fw-bold"><%=texts.LASTBOOT%>:&nbsp;</span>' + dateb.toLocaleDateString() + '&nbsp;' + dateb.toLocaleTimeString());
        // HeartBeat TS
        let dateh = new Date(result.data.last_heartbeat_ts * 1000)
        $('#lastheart').html('<span class="fw-bold"><%=texts.LASTHEART%>:&nbsp;</span>' + dateh.toLocaleDateString() + '&nbsp;' + dateh.toLocaleTimeString());
      },
      error: function (jqXHR, textStatus, err) {
        alert(jqXHR.responseText)
        clearInterval(interval1)
      }
    });
  }
  // Refresh Connector Data
  var interval2 = setInterval(reloadConnsStatus, 2500);
  function reloadConnsStatus() {
    $.ajax({
      url: '/ajax/connectors_status',
      type: 'POST',
      data: { ocppName: '<%=station.cb_id%>' },
      dataType: 'json',
      success: function (result) {
        for (const elem of result.data) {
          var status_bg = '#connstatus' + elem.connector_id
          var status_ts = '#connlaststatus' + elem.connector_id
          var meter_idx = '#connmeter' + elem.connector_id
          // Status Badge
          if (elem.status == 'Unavailable') {
            $(status_bg).html('<span class="fw-bold"><%=texts.AVAILABILITY%>:&nbsp;</span><span class="badge text-bg-warning"><%=texts.INOPERATIVEM%></span>');
          } else if (elem.status == 'Faulted') {
            $(status_bg).html('<span class="fw-bold"><%=texts.AVAILABILITY%>:&nbsp;</span><span class="badge text-bg-danger"><%=texts.FAULTY%></span>');
          } else {
            $(status_bg).html('<span class="fw-bold"><%=texts.AVAILABILITY%>:&nbsp;</span><span class="badge text-bg-success"><%=texts.OPERATIVEM%></span>');
          }
          // Status TS
          let date = new Date(elem.status_ts * 1000)
          $(status_ts).html('<span class="fw-bold"><%=texts.LASTSTATUS%>:&nbsp;</span>' + date.toLocaleDateString() + '&nbsp;' + date.toLocaleTimeString());
          // Meter
          let energy = (elem.energy / 1000)
          $(meter_idx).html('<span class="fw-bold"><%=texts.METERINDEX%>:&nbsp;</span>' + energy + '&nbsp;<%=texts.ENERGYUNIT%>');
        }
      },
      error: function (jqXHR, textStatus, err) {
        alert(jqXHR.responseText)
        clearInterval(interval2)
      }
    });
  }
  reloadConnsStatus();
</script>
<%- include('./partials/footer.ejs') %>