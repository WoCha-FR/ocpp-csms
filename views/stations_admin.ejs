<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <%- include('./partials/ocpperrors.ejs') %>
  <% if (typeof infosui.ocppResult !=='undefined' ) { %>
    <div id="ocppResponse" class="alert alert-warning" role="alert">
      <%=infosui.ocppResult.filename%>
    </div>
  <% } %>
  <div class="card">
    <!-- CARD HEADER-->
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs" id="stations-tabs" role="tablist">
        <li class="nav-item" role="presentation">
          <a class="nav-link active" id="stations-tabs-list-tab" data-bs-target="#stations-tabs-list"
            aria-controls="stations-tabs-list" data-bs-toggle="tab" type="button" role="tab" aria-selected="true">
            <%=texts.STATIONS%>
          </a>
        </li>
        <li class="nav-item" role="presentation">
          <a class="nav-link" id="stations-tabs-add-tab" data-bs-target="#stations-tabs-add"
            aria-controls="stations-tabs-add" data-bs-toggle="tab" type="button" role="tab" aria-selected="false">
            <%=texts.ADD%>
          </a>
        </li>
      </ul>
    </div>
    <!-- CARD HEADER-->
    <!-- CARD BODY -->
    <div class="card-body">
      <!-- TABS CONTENT -->
      <div id="stations-tabs-conteneur" class="tab-content">
        <!-- ALL STATIONS TAB -->
        <div id="stations-tabs-list" class="tab-pane fade active show" role="tabpanel" aria-labelledby="stations-tabs-list-tab">
          <!-- TABLE -->
          <div class="card p-3">
            <table id="stationstable" class="table table-striped table-hover" data-toggle="table" data-locale="<%=texts.LOCALE%>" data-mobile-responsive="true"
              data-search="true" data-search-highlight="true" data-search-align="left">
              <thead>
                <tr>
                  <th data-sortable="true" data-field="s_name"><%=texts.SITE%></th>
                  <th data-sortable="true" data-field="name"><%=texts.NOM%></th>
                  <th data-sortable="true" data-field="ocppid"><%=texts.OCPP_ID%></th>
                  <th data-sortable="true" data-field="regstatus"><%=texts.OCPP_STATUS%></th>
                  <th data-sortable="true"><%=texts.ONLINE%></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
              <% if(stations.length> 0) { %>
                <% stations.forEach(function(station) { %>
                <tr>
                  <td style="cursor: pointer;"><%= station.s_name %></td>
                  <td style="cursor: pointer;"><%= station.cb_name %></td>
                  <td style="cursor: pointer;"><%= station.cb_id %></td>
                  <% if(station.registration_status=='Rejected' ) { %>
                  <td data-searchable="false"><span class="badge text-bg-danger"><%=texts.REJECTEDF%></span></td>
                  <% } else if(station.registration_status=='Pending' ) { %>
                  <td data-searchable="false"><span class="badge text-bg-warning"><%=texts.PENDING%></span></td>
                  <% } else { %>
                  <td data-searchable="false"><span class="badge text-bg-success"><%=texts.ACCEPTEDF%></span></td>
                  <% } %>
                  <% if(station.online==1) { %>
                  <td data-searchable="false"><span class="badge text-bg-success"><%=texts.ONLINE%></span></td>
                  <% } else if(station.online==0) { %>
                  <td data-searchable="false"><span class="badge text-bg-danger"><%=texts.OFFLINE%></span></td>
                  <% } else { %>
                  <td data-searchable="false"><span class="badge text-bg-warning"><%=texts.PENDING%></span></td>
                  <% } %>
                  <td>
                    <a class="btn btn-sm btn-warning" href="/station/edit/<%=station.cb_pk%>" title="Update"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-primary" href="/station/<%=station.cb_id%>/diagnostic" title="Diagnostics"><i class="bi bi-heart-pulse"></i></a>
                    <a class="btn btn-sm btn-danger btn-delete-elem" data-form-elemid="<%=station.cb_pk%>" data-bs-toggle="modal" data-bs-target="#deleteMod" title="Delete"><i class="bi bi-trash3"></i></a>
                  </td>
                </tr>
                <% }); %>
              <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- ALL STATIONS TAB -->
        <!-- ADD STATION TAB -->
        <div id="stations-tabs-add" class="tab-pane fade" role="tabpanel" aria-labelledby="stations-tabs-add-tab" tabindex="0">
          <div class="card">
            <div class="card-header"><%=texts.STATION_INFOS%></div>
            <form method="post" action="/stations/add">
              <input type="hidden" name="regstatus" value="Accepted">
              <div class="card-body">
                <!-- FORMULAIRE -->
                <div class="row mb-3">
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-ev-station-fill"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="cbname" id="unameInput" placeholder="" required>
                        <label for="unameInput"><%=texts.STATION_NAME%></label>
                      </div>
                    </div>
                  </div>
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-geo-fill"></i></span>
                      <div class="form-floating">
                        <select class="form-select" name="cbsite" id="cbsiteInput">
                          <% sites.forEach(function(site) { %>
                          <option value="<%=site.s_pk%>"><%=site.s_name%></option>
                          <% }) %>
                        </select>
                        <label for="cbsiteInput"><%=texts.SITE%></label>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-fingerprint"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="cbid" id="inputcbid" placeholder="" required>
                        <label for="inputcbid"><%=texts.OCPP_ID%></label>
                      </div>
                    </div>
                  </div>
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="cbpwd" id="cbpwdInput" placeholder="">
                        <label for="cbpwdInput"><%=texts.PASSWORD_OCPP%></label>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- FORMULAIRE -->
                <br><!-- TODO Traduction + lien WS -->
                <p>Use the URLs below to configure ocpp endpoint your charging station communicates with.
                  Use the secure URL if it's supported by the station.</p>
              </div>
              <div class="card-footer">
                <button class="btn btn-primary" type="submit"><%=texts.ADD%></button>
              </div>
            </form>
          </div>
        </div>
        <!-- ADD STATION TAB -->
      </div>
    </div>
    <!-- CARD BODY -->
  </div>

  <!-- Modal -->
  <div class="modal fade" id="deleteMod" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body">
          <%=texts.CONFIRM_DELETE%>
        </div>
        <div class="modal-footer">
          <form action="/station/delete" method="post" id="ModalFormDelete">
            <input type="hidden" name="chargerId" id="ModalFormDeleteId" value="">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <%=texts.NON%>
            </button>
            <button type="submit" class="btn btn-danger">
              <%=texts.YES%>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <!-- Modal -->
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function() {
    $('#inputErrors').delay(5000).fadeOut('slow');
    $('#stationstable').removeClass('table-bordered');

    $('.btn-delete-elem').click(function (e) {
      e.preventDefault();
      var id = $(this).attr('data-form-elemid');
      $('#ModalFormDeleteId').attr('value', id)
    });

    $('#deleteMod').on('hidden.bs.modal', function (e) {
      $('#ModalFormDeleteId').attr('value', '');
    });
  });
  // Click to Station page
  $('#stationstable').on('click-cell.bs.table', function (e, field, value, row, $element) {
    cellIndex = $element[0].cellIndex;
    if (cellIndex != 5) {
      window.location.href = '/station/' + row.ocppid;
    }
  });
  // Refresh Stations
  // TODO : Ajax refresh function
</script>
<%- include('./partials/footer.ejs') %>