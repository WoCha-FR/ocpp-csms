<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <%- include('./partials/ocpperrors.ejs') %>
  <div class="card">
    <!-- CARD HEADER-->
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs" id="sites-tabs" role="tablist">
        <li class="nav-item" role="presentation">
          <a class="nav-link active" id="sites-tabs-list-tab" data-bs-target="#sites-tabs-list"
            aria-controls="sites-tabs-list" data-bs-toggle="tab" type="button" role="tab" aria-selected="true">
            <%=texts.SITES%>
          </a>
        </li>
        <li class="nav-item" role="presentation">
          <a class="nav-link" id="sites-tabs-add-tab" data-bs-target="#sites-tabs-add"
            aria-controls="sites-tabs-add" data-bs-toggle="tab" type="button" role="tab" aria-selected="false">
            <%=texts.ADD%>
          </a>
        </li>
      </ul>
    </div>
    <!-- CARD HEADER-->
    <!-- CARD BODY -->
    <div class="card-body">
      <div id="sites-tabs-conteneur" class="tab-content">
        <!-- ALL SITES TAB -->
        <div id="sites-tabs-list" class="tab-pane fade active show" role="tabpanel" aria-labelledby="sites-tabs-list-tab">
          <!-- TABLE -->
          <div class="card p-3">
            <table id="sitestable" class="table table-striped table-hover" data-toggle="table" data-locale="<%=texts.LOCALE%>"
              data-mobile-responsive="true" data-search="true" data-search-highlight="true" data-search-align="left">
              <thead>
                <tr>
                  <th data-sortable="true" data-field="s_name"><%=texts.NOM%></th>
                  <th data-sortable="true" data-field="s_address"><%=texts.ADDRESS%></th>
                  <th data-sortable="true" data-field="s_codp"><%=texts.ZIPCODE%></th>
                  <th data-sortable="true" data-field="s_ville"><%=texts.VILLE%></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
              <% if(sites.length> 0) { %>
                <% sites.forEach(function(site) { %>
                <tr>
                  <td><%=site.s_name%></td>
                  <td><%=site.s_address%></td>
                  <td><%=site.s_codp%></td>
                  <td><%=site.s_ville%></td>
                  <td>
                    <a class="btn btn-sm btn-warning" href="/admin/site/edit/<%=site.s_pk%>" title="Update"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-danger btn-delete-elem" data-form-elemid="<%=site.s_pk%>" data-bs-toggle="modal" data-bs-target="#deleteMod" title="Delete"><i class="bi bi-trash3"></i></a>
                  </td>
                </tr>
                <% }); %>
              <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- ALL SITES TAB -->
        <!-- ADD SITES TAB -->
        <div class="tab-pane fade" id="sites-tabs-add" role="tabpanel" aria-labelledby="sites-tabs-add-tab" tabindex="0">
          <div class="card">
            <div class="card-header"><%=texts.SITE_INFOS%></div>
            <form method="post" action="/admin/site/add">
              <div class="card-body">
                <!-- FORMULAIRE -->
                <div class="row mb-3">
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-pin-map"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="sname" id="snameInput" placeholder="" required>
                        <label for="snameInput"><%=texts.NOM%></label>
                      </div>
                    </div>
                  </div>
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-signpost-2"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="saddr" id="saddrInput" placeholder="">
                        <label for="saddrInput"><%=texts.ADDRESS%></label>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="row mb-3">
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-123"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="scodp" id="scodpInput" placeholder="">
                        <label for="scodpInput"><%=texts.ZIPCODE%></label>
                      </div>
                    </div>
                  </div>
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-houses"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="sville" id="svilleInput" placeholder="">
                        <label for="svilleInput"><%=texts.VILLE%></label>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- FORMULAIRE -->
              </div>
              <div class="card-footer">
                <button class="btn btn-primary" type="submit"><%=texts.ADD%></button>
              </div>
            </form>
          </div>
        </div>
        <!-- ADD SITES TAB -->
      </div>
    </div>
    <!-- CARD BODY -->
  </div>

  <!-- Modal -->
  <div class="modal fade" id="deleteMod" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body"><%=texts.CONFIRM_DELETE%></div>
        <div class="modal-footer">
          <form action="/admin/site/delete" method="post" id="ModalFormDelete">
            <input type="hidden" name="elemId" id="ModalFormDeleteId" value="">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <%=texts.NON%>
            </button>
            <button type="submit" class="btn btn-danger">
              <%=texts.YES%>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <!-- Modal -->
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#inputErrors').delay(5000).fadeOut('slow');
    $('#sitestable').removeClass('table-bordered');
    // Modal
    $('.btn-delete-elem').click(function (e) {
      e.preventDefault();
      var id = $(this).attr('data-form-elemid');
      $('#ModalFormDeleteId').attr('value', id)
    });
    $('#deleteMod').on('hidden.bs.modal', function (e) {
      $('#ModalFormDeleteId').attr('value', '');
    });
  });
</script>
<%- include('./partials/footer.ejs') %>