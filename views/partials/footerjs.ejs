<script src="/js/btable-<%=texts.LANG%>.min.js"></script>
<% if (typeof pendings !== 'undefined') { %>
<script>
  var interval = setInterval(reloadPendings, 5000);
  function reloadPendings() {
    $.ajax({
      url: '/refreshPendings',
      type: 'POST',
      dataType: 'json',
      success: function (result) {
        var html = result['html']
        $('#pendingChargers').html(html)
        if (result['nbpending'] > 0) {
          $('#pendingChargers').addClass('d-block').removeClass('d-none')
        } else {
          $('#pendingChargers').addClass('d-none').removeClass('d-block')
        }
      },
      error: function (jqXHR, textStatus, err) {
        alert('Error: ' + textStatus + ', err ' + err)
        clearInterval(interval)
      }
    });
  }
  reloadPendings();
</script>
<% } %>