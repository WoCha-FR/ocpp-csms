<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <%- include('./partials/ocpperrors.ejs') %>

  <div class="card">
    <!-- CARD HEADER-->
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs" id="users-tabs" role="tablist">
        <li class="nav-item" role="presentation">
          <a class="nav-link active" id="users-tabs-list-tab" data-bs-target="#users-tabs-list"
            aria-controls="users-tabs-list" data-bs-toggle="tab" type="button" role="tab" aria-selected="true">
            <%=texts.USERS%>
          </a>
        </li>
        <li class="nav-item" role="presentation">
          <a class="nav-link" id="users-tabs-add-tab" data-bs-target="#users-tabs-add"
            aria-controls="users-tabs-add" data-bs-toggle="tab" type="button" role="tab" aria-selected="false">
            <%=texts.ADD%>
          </a>
        </li>
      </ul>
    </div>
    <!-- CARD HEADER-->
    <!-- CARD BODY -->
    <div class="card-body">
      <!-- TABS CONTENT -->
      <div id="users-tabs-conteneur" class="tab-content">
        <!-- ALL USERS TAB -->
        <div id="users-tabs-list" class="tab-pane fade active show" role="tabpanel" aria-labelledby="users-tabs-list-tab">
          <div class="card p-3">
            <table id="users-table" class="table table-hover table-striped" data-toggle="table" data-locale="<%=texts.LOCALE%>" data-mobile-responsive="true">
              <thead>
                <tr>
                  <th data-sortable="true" data-field="name"><%=texts.NOM%></th>
                  <th data-sortable="true" data-field="username"><%=texts.USERNAME%></th>
                  <th data-sortable="true" data-field="level"><%=texts.USER_RIGHTS%></th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
              <% if(users.length> 0) { %>
                <% users.forEach(function(user) { %>
                <tr>
                  <td><%=user.name%></td>
                  <td><%=user.username%></td>
                  <td>
                    <% if (user.isAdmin) { %>
                      <i class="bi bi-gear-wide-connected"></i>&nbsp;<%=texts.USER_ADMIN%>
                    <% } %>
                    <% if (user.ownedSite) { %>
                      <i class="bi bi-ev-station"></i>&nbsp;<%=texts.USER_OWNER%>
                    <% } %>
                  </td>
                  <td>
                    <a class="btn btn-sm btn-warning" href="/users/edit/<%=user.user_pk%>" title="Update"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-danger btn-delete-user" data-form-userid="<%=user.user_pk%>" data-bs-toggle="modal" data-bs-target="#deleteMod" title="Delete"><i class="bi bi-trash3"></i></a>
                  </td>
                </tr>
                <% }); %>
              <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- ALL USERS TAB -->
        <!-- ADD USER TAB -->
        <div class="tab-pane fade" id="users-tabs-add" role="tabpanel" aria-labelledby="users-tabs-add-tab" tabindex="0">
          <div class="card">
            <div class="card-header"><%=texts.USER_INFOS%></div>
            <form method="post" action="/users/add">
              <div class="card-body">
                <!-- FORMULAIRE -->
                <div class="row mb-3">
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-person-vcard"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="uname" id="unameInput" aria-describedby="unameHelpBlock" placeholder="" required>
                        <label for="unameInput"><%=texts.USER%></label>
                      </div>
                    </div>
                    <div id="unameHelpBlock" class="form-text"><%=texts.USERNOM_INFOS%></div>
                  </div>
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-envelope-at"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="email" name="umail" id="umailInput" aria-describedby="umailHelpBlock" placeholder="" required>
                        <label for="umailInput"><%=texts.EMAIL_ADDR%></label>
                      </div>
                    </div>
                    <div id="umailHelpBlock" class="form-text"><%=texts.USERMAIL_INFOS%></div>
                  </div>
                </div>
                <div class="row mb-3">
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-person"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="username" id="uuserInput" aria-describedby="uuserHelpBlock" placeholder="" required>
                        <label for="uuserInput"><%=texts.USERNAME%></label>
                      </div>
                    </div>
                    <div id="uuserHelpBlock" class="form-text"><%=texts.USERNAME_INFOS%></div>
                  </div>
                  <div class="col-sm-6">
                    <div class="input-group" id="show_hide_password">
                      <span class="input-group-text"><i class="bi bi-key"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="password" name="password" id="upassInput" aria-describedby="upassHelpBlock" placeholder="" required>
                        <label for="upassInput"><%=texts.PASSWORD%></label>
                      </div>
                      <span class="input-group-text"><a href="" class="nav-link"><i class="bi bi-eye-slash"></i></a></span>
                    </div>
                    <div id="upassHelpBlock" class="form-text"><%=texts.USERPASS_INFOS%></div>
                  </div>
                </div>
                <div class="row mb-3">
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-person-lock"></i></span>
                      <div class="form-floating">
                        <select class="form-select" name="ulevel" id="ulevelInput" aria-describedby="ulevelHelpBlock">
                          <option value="2" selected><%=texts.USER_OWNER%></option>
                          <option value="1"><%=texts.USER_ADMIN%></option>
                        </select>
                        <label for="ulevel"><%=texts.USER_RIGHTS%></label>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- FORMULAIRE -->
              </div>
              <div class="card-footer">
                <button class="btn btn-primary" type="submit">
                  <%=texts.ADD%>
                </button>
              </div>
            </form>
          </div>
        </div>
        <!-- ADD USER TAB -->
      </div>
      <!-- TABS CONTENT -->
    </div>
    <!-- CARD BODY -->
  </div>

  <!-- Modal -->
  <div class="modal fade" id="deleteMod" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body"><%=texts.CONFIRM_DELETE%></div>
        <div class="modal-footer">
          <form action="/users/delete" method="post" id="ModalFormDelete">
            <input type="hidden" name="userId" id="ModalFormUserId" value="">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%=texts.NON%></button>
            <button type="submit" class="btn btn-danger"><%=texts.YES%></button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <!-- Modal -->
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#inputErrors').delay(5000).fadeOut('slow');
    $('#users-table').removeClass('table-bordered');

    $("#show_hide_password a").on('click', function (event) {
      event.preventDefault();
      if ($('#show_hide_password input').attr("type") == "text") {
        $('#show_hide_password input').attr('type', 'password');
        $('#show_hide_password i').addClass("bi-eye-slash");
        $('#show_hide_password i').removeClass("bi-eye");
      } else {
        $('#show_hide_password input').attr('type', 'text');
        $('#show_hide_password i').removeClass("bi-eye-slash");
        $('#show_hide_password i').addClass("bi-eye");
      }
    });

    $('.btn-delete-user').click(function (e) {
      e.preventDefault();
      var id = $(this).attr('data-form-userid');
      $('#ModalFormUserId').attr('value', id)
    });

    $('#deleteMod').on('hidden.bs.modal', function (e) {
      $('#ModalFormUserId').attr('value', '');
    });
  });
</script>
<%- include('./partials/footer.ejs') %>