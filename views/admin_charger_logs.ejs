<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row align-items-center">
        <div class="col-md-auto fs-2"><%=texts.STATION%>&nbsp;<%= station.cb_name %></div>
        <div class="col" id="cbonline">
          <% if(station.online==1) { %>
          <span class="badge text-bg-success fs-6"><%=texts.ONLINE%></span>
          <% } else if(station.online==0) { %>
          <span class="badge text-bg-danger fs-6"><%=texts.OFFLINE%></span>
          <% } else { %>
          <span class="badge text-bg-warning fs-6"><%=texts.PENDING%></span>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('./partials/ocpperrors.ejs') %>
  <div class="card mb-3">
    <!-- CARD HEADER-->
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs">
        <li class="nav-item">
          <a class="nav-link" href="/charger/<%= station.cb_id %>/"><%=texts.STATION%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/charger/<%= station.cb_id %>/connectors"><%=texts.CONNECTORS%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/charger/<%= station.cb_id %>/logs" aria-current="page"><%=texts.LOGS%></a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/charger/<%= station.cb_id %>/ocppconfig"><%=texts.CONFIG_OCPP%></a>
        </li>
      </ul>
    </div>
    <!-- CARD HEADER-->
    <!-- CARD BODY -->
    <div class="card-body">
      <div class="row mb-2">
        <div class="col-md-3">
          <div class="input-group input-group-sm flatpickr">
            <div class="input-group-text"><%=texts.DATE%></div>
            <input type="text" class="form-control" id="dateInput" readonly="readonly" data-input>
            <span class="input-group-text" data-clear><i class="bi bi-calendar2-x"></i></span>
          </div>
        </div>
        <div class="col-md-5" id="myFilter">
          <div class="row">
            <div class="col input-group-sm"><select class="form-control bootstrap-table-filter-control-method">
                <option value=""></option>
              </select></div>
          </div>
        </div>
        <div class="col-md-2">
          <div class="input-group input-group-sm">
            <span class="input-group-text" id="basic-addon1"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" aria-label="<%=texts.SEARCH%>" aria-describedby="basic-addon1" id="mySearch">
          </div>
        </div>
        <div class="col-md-2 text-end">
          <button type="button" class="btn btn-secondary btn-sm" id="refreshTable"><i class="bi bi-arrow-clockwise"></i></button>
          <button type="button" class="btn btn-secondary btn-sm" id="exportTable"><i class="bi bi-download"></i></button>
        </div>
      </div>
      <table class="table table-sm" id="logstab" data-toggle="table" data-locale="<%=texts.LOCALE%>" data-mobile-responsive="true" >
        <thead>
          <th data-field="timestamp" data-formatter="tsFormatter"><%=texts.DATETIME%></th>
          <th data-field="direction"><%=texts.DIRECTION%></th>
          <th data-field="type"><%=texts.TYPE%></th>
          <th data-field="method" data-filter-control="select"><%=texts.METHOD%></th>
          <th data-field="message" class="text-break"><%=texts.MESSAGE%></th>
        </thead>
      </table>
    </div>
    <!-- CARD BODY -->
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script src="/js/btable-filter.min.js"></script>
<script src="/js/jquery-table-export.min.js"></script>
<script src="/js/btable-export.min.js"></script>
<script src="/js/flatpickr.min.js"></script>
<% if (texts.LANG=='fr' ) { %>
<script src="/js/flatpickr-fr.min.js"></script>
<% } %>
<script>
  // Document
  $(document).ready(function () {
    $('#inputErrors').delay(5000).fadeOut('slow');
  });
  // Flatpickr
  const tsnow = new Date()
  const defaultDate = flatpickr.formatDate(tsnow, "D Y-m-d")
  const elem = document.querySelector('div[class$="flatpickr"]');
  const picker = flatpickr(elem, {
    mode: "range",
    maxDate: "today",
    dateFormat: "D Y-m-d",
    defaultDate: [defaultDate, defaultDate],
    wrap: true,
    onClose: function (selectedDates, dateStr, instance) {
      $('#logstab').bootstrapTable('refresh')
    },
    onChange: function (selectedDates, dateStr, instance) {
      if (dateStr == '') {
        $('#logstab').bootstrapTable('refresh')
      }
    },
  });
  // BootstrapTable
  $(function () {
    $('#logstab').bootstrapTable('refreshOptions', {
      search: true,
      searchHighlight: true,
      searchSelector: '#mySearch',
      loadingTemplate: 'loadingTemplate',
      pagination: true,
      paginationVAlign: 'top',
      pageSize: 50,
      pageList: [50, 100, 250, 'All'],
      ajax: "ajaxRequest",
      queryParams: 'queryParams',
      filterControl: true,
      filterControlContainer: '#myFilter'
    })
  })
  // BSTable - data-formater
  function tsFormatter(value) {
    let jsdate = new Date(value)
    return jsdate.toLocaleDateString() + ' ' + jsdate.toLocaleTimeString() + '.' + jsdate.getMilliseconds()
  }
  // BSTable - Loading Template
  function loadingTemplate(message) {
    return [
      '<div class="d-flex justify-content-center bsloading"><strong class="me-3 mt-1">',
      message,
      '</strong><div class="spinner-border" role="status" aria-hidden="true"></div></div>'
    ].join('')
  }
  // BSTable - Ajax Query
  function ajaxRequest(params) {
    $.ajax({
      type: 'POST',
      url: '/ajax/charger_logs',
      data: $.param(params.data),
      dataType: 'json',
      success: function (response) {
        params.success(response)
      },
      error: function (er) {
        params.error(er.statusText)
      }
    });
  }
  // BSTable - Ajax Query Params
  function queryParams(params) {
    if (picker.selectedDates.length == 2) {
      params.start = picker.selectedDates[0].getTime()
      params.stop = (picker.selectedDates[1].getTime() + 86399000)
    } else if (picker.selectedDates.length == 1) {
      params.start = picker.selectedDates[0].getTime()
      params.stop = params.start + 86399000
    } else {
      var d = new Date()
      d.setHours(0, 0, 0, 0)
      params.start = d.getTime()
      params.stop = params.start + 86399000
    }
    params.ocppName = '<%= station.cb_id %>'
    return params
  }
  // Refresh
  $('#refreshTable').on('click', function (event) {
    event.preventDefault()
    $('#logstab').bootstrapTable('refresh')
  });
  // Table Export
  $('#exportTable').on('click', function (event) {
    event.preventDefault()
    $('#logstab').tableExport({
      type: 'csv',
      csvSeparator: ';',
      fileName: 'logsExport'
    });
  });
</script>
<% if (texts.LANG=='fr') { %>
<script>
  picker.set('locale', 'fr')
  picker.set("dateFormat", "D d/m/Y")
</script>
<% } %>
<script>
  // Refresh Charger Data
  var interval1 = setInterval(reloadChargerStatus, 5000);
  function reloadChargerStatus() {
    $.ajax({
      url: '/ajax/charger_status',
      type: 'POST',
      data: { ocppName: '<%= station.cb_id %>' },
      dataType: 'json',
      success: function (result) {
        if (result.data.online === 1) {
          $('#cbonline').html('<span class="badge text-bg-success fs-6"><%=texts.ONLINE%></span>')
        } else if (result.data.online === 0) {
          $('#cbonline').html('<span class="badge text-bg-danger fs-6"><%=texts.OFFLINE%></span>')
        } else {
          $('#cbonline').html('<span class="badge text-bg-warning fs-6"><%=texts.PENDING%></span>')
        }
      },
      error: function (jqXHR, textStatus, err) {
        alert(jqXHR.responseText)
        clearInterval(interval1)
      }
    });
  }
</script>
<%- include('./partials/footer.ejs') %>