<%- include('./partials/header.ejs') %>
<main class="container-fluid">
  <%- include('./partials/ocpperrors.ejs') %>
  <div class="card mb-3">
    <!-- CARD HEADER-->
    <div class="card-header">
      <ul class="nav nav-tabs card-header-tabs" id="rfids-tabs" role="tablist">
        <li class="nav-item" role="presentation">
          <a class="nav-link active" id="rfids-tabs-list-tab" data-bs-target="#rfids-tabs-list"
            aria-controls="rfids-tabs-list" data-bs-toggle="tab" type="button" role="tab" aria-selected="true">
            <%=texts.RFID_CARDS%>
          </a>
        </li>
        <li class="nav-item" role="presentation">
          <a class="nav-link" id="rfids-tabs-add-tab" data-bs-target="#rfids-tabs-add" aria-controls="rfids-tabs-add"
            data-bs-toggle="tab" type="button" role="tab" aria-selected="false">
            <%=texts.ADD%>
          </a>
        </li>
      </ul>
    </div>
    <!-- FIN CARD HEADER-->
    <div class="card-body">
      <!-- TABS CONTENT -->
      <div id="rfids-tabs-conteneur" class="tab-content">
        <!-- RFIDS TAB -->
        <div id="rfids-tabs-list" class="tab-pane fade active show" role="tabpanel" aria-labelledby="rfids-tabs-list-tab">
          <div class="card p-3">
            <table id="rfidstable" class="table table-striped table-hover" data-toggle="table" data-locale="<%=texts.LOCALE%>"
              data-mobile-responsive="true" data-search="true" data-show-search-button="true" data-search-highlight="true" data-search-align="left">
              <thead>
                <th data-sortable="true" data-field="idtag"><%=texts.IDTAG%></th>
                <th data-sortable="true" data-field="rf_name"><%=texts.CARD_NAME%></th>
                <th data-sortable="true" data-field="blocked"><%=texts.STATE%></th>
                <th data-sortable="true" data-field="expire" data-formatter="tsFormatter"><%=texts.EXPIRE%></th>
                <th data-sortable="true" data-field="uname"><%=texts.USER%></th>
                <th></th>
              </thead>
              <tbody>
              <% rfids.forEach(function(rfid) { %>
                <tr>
                  <td><%= rfid.idtag %></td>
                  <td><%= rfid.rf_name %></td>
                  <% if(rfid.blocked==1) { %>
                  <td data-searchable="false"><span class="badge text-bg-danger"><%=texts.REJECTEDF%></span></td>
                  <% } else { %>
                  <td data-searchable="false"><span class="badge text-bg-success"><%=texts.ACCEPTEDF%></span></td>
                  <% } %>
                  <td><%= rfid.expire %></td>
                  <td><%- rfid.uname ? rfid.uname : texts.NONAFFECTE %></td>
                  <td>
                    <a class="btn btn-sm btn-warning" href="/site/rfid/edit/<%=rfid.rf_pk%>" title="Update"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-danger btn-delete-elem" data-form-elemid="<%=rfid.rf_pk%>" data-bs-toggle="modal" data-bs-target="#deleteMod" title="Delete"><i class="bi bi-trash3"></i></a>
                  </td>
                </tr>
              <% }); %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- ADD RFIDS TAB -->
        <div id="rfids-tabs-add" class="tab-pane fade" role="tabpanel" aria-labelledby="rfids-tabs-add-tab" tabindex="0">
          <div class="card">
            <div class="card-header"><%=texts.RFID_INFOS%></div>
            <form method="post" action="/site/rfid/add">
              <div class="card-body">
                <div class="row mb-3">
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="rftag" id="rftagInput" placeholder="" maxlength="20" required>
                        <label for="rftagInput"><%=texts.IDTAG%></label>
                      </div>
                    </div>
                  </div>
                  <div class="col-sm-6">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-info-lg"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="rfname" id="rfnameInput" placeholder="" maxlength="50" required>
                        <label for="rfnameInput"><%=texts.CARD_NAME%></label>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-sm-4">
                    <div class="input-group pt-2">
                      <span class="input-group-text"><i class="bi bi-gear"></i></span>
                      <input type="radio" class="btn-check" name="rfblocked" value="0" id="rfActive" checked>
                      <label class="btn btn-outline-success form-control" for="rfActive"><%=texts.ACCEPTEDF%></label>
                      <input type="radio" class="btn-check" name="rfblocked" value="1" id="rfInactive">
                      <label class="btn btn-outline-danger form-control" for="rfInactive"><%=texts.REJECTEDF%></label>
                    </div>
                  </div>
                  <div class="col-sm-4">
                    <div class="input-group flatpickr">
                      <span class="input-group-text"><i class="bi bi-hourglass-split"></i></span>
                      <div class="form-floating">
                        <input class="form-control" type="text" name="rfexpire" readonly="readonly" id="rfdateInput" data-input>
                        <label for="rfdateInput"><%=texts.EXPIRE%></label>
                      </div>
                      <span class="input-group-text" data-clear><i class="bi bi-calendar2-x"></i></span>
                    </div>
                  </div>
                  <div class="col-sm-4">
                    <div class="input-group">
                      <span class="input-group-text"><i class="bi bi-person"></i></span>
                      <div class="form-floating">
                        <select class="form-select" name="rfuser" id="rfuserInput">
                          <option value="" selected><%=texts.NONAFFECTE%></option>
                          <%users.forEach(function(user) { %>
                          <option value="<%=user.upk%>"><%=user.uname%> (<%=user.usermail%>)</option>
                          <% }) %>
                        </select>
                        <label for="rfuserInput"><%=texts.USER%></label>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="card-footer">
                <button class="btn btn-primary" type="submit"><%=texts.ADD%></button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Modal -->
  <div class="modal fade" id="deleteMod" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body">
          <%=texts.CONFIRM_DELETE%>
        </div>
        <div class="modal-footer">
          <form action="/site/rfid/delete" method="post" id="ModalFormDelete">
            <input type="hidden" name="elemId" id="ModalFormDeleteId" value="">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%=texts.NON%></button>
            <button type="submit" class="btn btn-danger"><%=texts.YES%></button>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('./partials/footerjs.ejs') %>
<script>
  $(document).ready(function () {
    $('#inputErrors').delay(5000).fadeOut('slow');
    $('#rfidstable').removeClass('table-bordered');

    $('.btn-delete-elem').click(function (e) {
      e.preventDefault();
      var id = $(this).attr('data-form-elemid');
      $('#ModalFormDeleteId').attr('value', id)
    });

    $('#deleteMod').on('hidden.bs.modal', function (e) {
      $('#ModalFormDeleteId').attr('value', '');
    });
  });

  function tsFormatter(value) {
    if (value) {
      let jsdate = new Date(value * 1000)
      return jsdate.toLocaleString()
    }
  }
</script>
<script src="/js/flatpickr.min.js"></script>
<% if (texts.LANG=='fr' ) { %>
<script src="/js/flatpickr-fr.min.js"></script>
<script>flatpickr.localize(flatpickr.l10ns.fr);</script>
<% } %>
<script>
  const elem = document.querySelector('div[class="input-group flatpickr"]');
  const picker = flatpickr(elem, {
    minDate: new Date().fp_incr(1),
    maxDate: new Date().fp_incr(366),
    altInput: true,
    altFormat: "l, d F Y G:i K",
    dateFormat: "U",
    enableTime: true,
    wrap: true
  });
</script>
<% if (texts.LANG=='fr' ) { %>
<script>
  picker.set("altFormat", "l d F Y H:i");
</script>
<% } %>
<%- include('./partials/footer.ejs') %>